function updateAutoCopyIntervals()
    local newInterval = (UIRefs.CopySpeedInput and tonumber(UIRefs.CopySpeedInput.Text) or 7)
    newInterval = newInterval or 7
    for i = 1, 6 do
        local btnType = "autoCopy" .. i
        if State.autoButtonsActive[btnType] then
            State.autoButtonsActive[btnType] = false
            updateVictimButtonState(btnType, false)
            State.autoButtonsActive[btnType] = true
            updateVictimButtonState(btnType, true)
            State.autoButtonsThreads[btnType] = coroutine.wrap(function()
                while State.autoButtonsActive[btnType] and State.currentVictim and State.victimExistsInServer do
                    executeAutoCopy(i)
                    task.wait(newInterval)
                end
                if not State.victimExistsInServer then
                    State.autoButtonsActive[btnType] = false
                    updateVictimButtonState(btnType, false)
                end
            end)()
        end
    end
end

local function deactivateGroupExcept(group, exception)
    for _, btnType in ipairs(group) do
        if btnType ~= exception then
            if btnType == "bang" and State.bangActive then
                stopBang()
            elseif btnType == "bangFront" and State.bangFrontFollowing then
                stopBangFront()
            elseif btnType == "headSuck" and State.headSucking then
                stopHeadSuck()
            elseif btnType == "annoyingBang" and State.annoyingBangActive then
                stopAnnoyingBang()
            elseif btnType == "fling" and State.flingActive then
                stopFling()
            elseif btnType == "backpackSit" and State.backpackSitActive then
                toggleBackpackSit()
            elseif btnType == "headSit" and State.headSitActive then
                toggleHeadSit()
            elseif btnType == "banqFares" and State.banqFaresActive then
                stopBanqFares()
            elseif State.autoButtonsActive[btnType] then
                State.autoButtonsActive[btnType] = false
                updateVictimButtonState(btnType, false)
            end
        end
    end
end
