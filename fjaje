    -- دالة مساعدة للكشف عن أداة الكلبشة
    local function isCuff(tool)
        if not tool or not tool:IsA("Tool") then return false end
        local name = tool.Name:lower()
        local keyWords = {"كلب", "cuff", "hand", "arrest", "كلبشه", "كلبشة"}
        for _, word in ipairs(keyWords) do
            if string.find(name, word) then
                return true
            end
        end
        return false
    end

    -- مضاد كلبشه v2 (يحتاج أدمن وكلبشه) - مع حذف الأداة بعد التنفيذ
    local RISE_HEIGHT = 5
    local function executeAntiCuffV2()
        if not hasHDAdmin or not RequestCommandSilent then return end
        local character = Player.Character
        if not character then return end
        local humanoid = character:FindFirstChild("Humanoid")
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not rootPart then return end
        local originalCF = rootPart.CFrame
        local targetCF = originalCF + Vector3.new(0, RISE_HEIGHT, 0)
        rootPart.Anchored = true
        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
        humanoid.PlatformStand = true
        local tweenUp = TweenService:Create(rootPart, TweenInfo.new(0.3), {CFrame = targetCF})
        tweenUp:Play()
        pcall(function() executeCommand("bigify") end)
        -- البحث عن أداة الكلبشة
        local usedCuff = nil
        pcall(function()
            local function findCuff()
                for _, item in ipairs(Player.Backpack:GetChildren()) do
                    if isCuff(item) then return item end
                end
                for _, item in ipairs(Player.Character:GetChildren()) do
                    if isCuff(item) then return item end
                end
                return nil
            end
            usedCuff = findCuff()
            if not usedCuff then task.wait(0.1); usedCuff = findCuff() end
            if usedCuff then
                usedCuff.Parent = Player.Character
                for _, obj in ipairs(usedCuff:GetDescendants()) do
                    if obj:IsA("RemoteEvent") then
                        obj:FireServer(rootPart)
                        break
                    end
                end
            end
        end)
        pcall(function() executeCommand("unbuffify") end)
        local startTime = tick()
        repeat task.wait() until tweenUp.PlaybackState == Enum.PlaybackState.Completed or tick() - startTime > 1
        local tweenDown = TweenService:Create(rootPart, TweenInfo.new(0.3), {CFrame = originalCF})
        tweenDown:Play()
        startTime = tick()
        repeat task.wait() until tweenDown.PlaybackState == Enum.PlaybackState.Completed or tick() - startTime > 1
        if (rootPart.Position - originalCF.Position).Magnitude > 1 then
            rootPart.CFrame = originalCF
        end
        rootPart.Anchored = false
        humanoid.WalkSpeed = 16
        humanoid.JumpPower = 50
        humanoid.PlatformStand = false
        -- حذف الأداة التي استخدمت في الكلبشة
        if usedCuff then
            task.delay(0.5, function()
                pcall(function() usedCuff:Destroy() end)
            end)
        end
    end

