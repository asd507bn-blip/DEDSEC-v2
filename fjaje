    end
    return Tween
end


   
    function DEDSEC .MakeDrag(Instance, savePositionCallback)
    task.spawn(function()
        SetProps(Instance, {
            Active = true,
            AutoButtonColor = false
        })
        local DragStart, StartPos, InputOn
        


local function Update(Input)
            local delta = Input.Position - DragStart
            local newOffsetX = StartPos.X.Offset + delta.X / UIScale
            local newOffsetY = StartPos.Y.Offset + delta.Y / UIScale
            local Position = UDim2.new(0, newOffsetX, 0, newOffsetY)
            DEDSEC.CreateTween({Instance, "Position", Position, 0.35})
        end
        Instance.MouseButton1Down:Connect(function()
            InputOn = true
        end)
        Instance.InputBegan:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
                StartPos = Instance.Position
                DragStart = Input.Position
                while UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
                    RunService.Heartbeat:Wait()
                    if InputOn then
                        Update(Input)
                    end
                end
                InputOn = false
                if savePositionCallback then
                    local pos = Instance.Position
                    local offsetX = pos.X.Offset
                    local offsetY = pos.Y.Offset
                    savePositionCallback(offsetX, offsetY)
                    DEDSEC.DebouncedDragSave()
                end
            end
        end)
    end)
    return Instance
end


   
