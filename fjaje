-- جدول لحفظ الخطوط الأصلية
local originalFonts = {}
local fontsSnapshotDone = false




local function snapshotOriginalFonts()
    if fontsSnapshotDone then return end
    fontsSnapshotDone = true
    


local function snapshot(container)
        for _, obj in ipairs(container:GetDescendants()) do
            if (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) and not originalFonts[obj] then
                originalFonts[obj] = obj.Font
            end
        end
    end
    if ScreenGui and ScreenGui.Parent then snapshot(ScreenGui) end
    if NotificationGui and NotificationGui.Parent then snapshot(NotificationGui) end
    -- snapshot للـ containers المخفية
    if window and window.ContainerList then
        for _, container in ipairs(window.ContainerList) do
            local wasNil = (container.Parent == nil)
            if wasNil then container.Parent = ScreenGui end
            snapshot(container)
            if wasNil then container.Parent = nil end
        end
    end
end

local savedFontName = "افتراضي"
if DEDSEC.Save.FontName then
    savedFontName = DEDSEC.Save.FontName
    currentFontName = savedFontName
    currentFontEnum = fontEnumMap[savedFontName]
end

local fontDropdown = settingsTab:AddDropdown({
    Title = "خط النصوص",
    Desc = "اختر الخط الذي يظهر على جميع النصوص - افتراضي يرجعها للخطوط الأصلية",
    Options = fontOptions,
    Default = savedFontName,
    Callback = function(selectedName)
        -- نحفظ الخطوط الأصلية قبل أول تغيير
        snapshotOriginalFonts()

        currentFontName = selectedName
        currentFontEnum = fontEnumMap[selectedName]
        DEDSEC.Save.FontName = selectedName
        DEDSEC.DebouncedSettingsSave()

        


local function applyFontToAll(container)
            for _, obj in ipairs(container:GetDescendants()) do
                if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                    if currentFontEnum then
                        -- احفظ الخط الأصلي إذا لم يُحفظ بعد
                        if not originalFonts[obj] then
                            originalFonts[obj] = obj.Font
                        end
                        obj.Font = currentFontEnum
                    else
                        -- رجوع للخط الأصلي المحفوظ
                        local orig = originalFonts[obj]
                        if orig then
                            obj.Font = orig
                        end
                    end
                end
            end
        end

        if ScreenGui and ScreenGui.Parent then
            applyFontToAll(ScreenGui)
        end
        if NotificationGui and NotificationGui.Parent then
            applyFontToAll(NotificationGui)
        end
        -- تطبيق على containers المخفية
        if window and window.ContainerList then
            for _, container in ipairs(window.ContainerList) do
                local wasNil = (container.Parent == nil)
                if wasNil then container.Parent = ScreenGui end
                applyFontToAll(container)
                if wasNil then container.Parent = nil end
            end
        end
    end
})

