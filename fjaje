            local function antivoid_start()
                local function toolMatch(handle)
                    for _, v in ipairs(Players:GetPlayers()) do
                        if v ~= Player then
                            local char = v.Character
                            if char then
                                local rightArm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightHand")
