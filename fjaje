function setAutoButton(buttonType, commandFunction, interval, enabled)
    if not hasHDAdmin then
        if enabled then showNotification("الماب هذا ليس فيه HD Admin", nil, false) end
        return
    end
    if enabled then
        if State.autoButtonsActive[buttonType] then return end
        if not checkVictimExists(true) then return end
        if table.find(group1Types, buttonType) then
            deactivateGroupExcept(group1Types, buttonType)
        elseif table.find(group2Types, buttonType) then
            deactivateGroupExcept(group2Types, buttonType)
        elseif table.find(group3Types, buttonType) then
            deactivateGroupExcept(group3Types, buttonType)
        end
        State.autoButtonsActive[buttonType] = true
        updateVictimButtonState(buttonType, true)
        State.autoButtonsThreads[buttonType] = coroutine.wrap(function()
            while State.autoButtonsActive[buttonType] and State.currentVictim and State.victimExistsInServer do
                commandFunction()
                task.wait(interval or 7)
            end
            if not State.victimExistsInServer then
                State.autoButtonsActive[buttonType] = false
                updateVictimButtonState(buttonType, false)
            end
        end)()
        saveCurrentVictimState()
    else
        if not State.autoButtonsActive[buttonType] then return end
        State.autoButtonsActive[buttonType] = false
        if State.autoButtonsThreads[buttonType] then State.autoButtonsThreads[buttonType] = nil end
        updateVictimButtonState(buttonType, false)
        saveCurrentVictimState()
    end
end

function toggleAutoButton(buttonType, commandFunction, interval)
    if State.autoButtonsActive[buttonType] then
        setAutoButton(buttonType, commandFunction, interval, false)
    else
        setAutoButton(buttonType, commandFunction, interval, true)
    end
end

