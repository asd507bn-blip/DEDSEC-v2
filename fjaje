    function DEDSEC .isArabicText(text)
    if type(text) ~= "string" then return false end
    for i = 1, #text do
        local charCode = string.byte(text, i)
        if charCode and ((charCode >= 0xD8 and charCode <= 0xDF) or (charCode >= 0x60 and charCode <= 0x6F)) then
            return true
        end
    end
    return false
end


   
    function DEDSEC .applyTextStyle(textLabel, forceUpdate)
    if not textLabel:IsA("TextLabel") and not textLabel:IsA("TextButton") and not textLabel:IsA("TextBox") then return end
    -- إذا في خط مخصص مختار نطبقه على الكل بدون استثناء
    if currentFontEnum then
        textLabel.Font = currentFontEnum
        return
    end
    if table.find(pixelFonts, textLabel.Font) then return end
    local text = textLabel.Text
    local isArabic = DEDSEC.isArabicText(text)
    if isArabic then
        if textLabel.Font ~= Enum.Font.ArialBold then
            textLabel.Font = Enum.Font.ArialBold
        end
    else
        if textLabel.Font ~= Enum.Font.GothamBold then
            textLabel.Font = Enum.Font.GothamBold
        end
    end
end

local glowingTexts = {}


   
    function DEDSEC .applyGlowToText(textLabel)
    if not textLabel then return end
    if not textLabel:IsA("TextLabel") and not textLabel:IsA("TextButton") and not textLabel:IsA("TextBox") then return end
    if textLabel:GetAttribute("NoTextGlow") then return end
    if glowingTexts[textLabel] then return end
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(180, 180, 180)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(180, 180, 180))
    })
    gradient.Rotation = 0
    gradient.Parent = textLabel
    local connection
   


local function animateGradient()
        while gradient and gradient.Parent do
            local tween = TweenService:Create(gradient, TweenInfo.new(3.2, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut), {Rotation = 360})
            tween:Play()
            tween.Completed:Wait()
            if gradient then gradient.Rotation = 0 end
        end
        if connection then connection:Disconnect() end
    end
    connection = task.spawn(animateGradient)
    glowingTexts[textLabel] = {
        gradient = gradient,
        connection = connection,
        isRunning = true
    }
    local destroyedConn
    destroyedConn = textLabel.AncestryChanged:Connect(function()
        if not textLabel.Parent then
            if connection and coroutine.running() ~= connection then
                task.cancel(connection)
            end
            if gradient then gradient:Destroy() end
            glowingTexts[textLabel] = nil
            if destroyedConn then destroyedConn:Disconnect() end
        end
    end)
end

