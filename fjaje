-- ====== جلب أدوات HD Admin بأمان (فحص فوري بدون انتظار، مع Cache) ======
local _HDAdminCache = nil
local _HDAdminChecked = false



local function GetHDRequestCommandSilent()
    if _HDAdminChecked then
        return _HDAdminCache
    end
    _HDAdminChecked = true
    pcall(function()
        -- فحص فوري: لو الماب فيه HD Admin فهو موجود أصلاً من بداية تحميل الماب
        -- فلا داعي للانتظار إطلاقًا، ولو مو موجود فلن يظهر لاحقًا بأي انتظار
        local hd = ReplicatedStorage:FindFirstChild("HDAdminHDClient")
        if hd then
            local sig = hd:FindFirstChild("Signals")
            if sig then
                _HDAdminCache = sig:FindFirstChild("RequestCommandSilent")
            end
        end
    end)
    return _HDAdminCache
end

-- كائن وهمي آمن يستخدم بدل RequestCommandSilent مباشرة
local SafeRequestCommandSilent = setmetatable({}, {
    __index = function(_, key)
        if key == "InvokeServer" then
            return function(_, ...)
                local raw = GetHDRequestCommandSilent()
                if raw then
                    local success, result = pcall(function(...)
                        return raw:InvokeServer(...)
                    end, ...)
                    if success then return result end
                end
                return nil
            end
        end
        local raw = GetHDRequestCommandSilent()
        if raw then return raw[key] end
        return nil
    end
})

