            local tween = TweenService:Create(notif, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Position = UDim2.new(1, -notifWidth - 10, 0, currentY)
            })
            tween:Play()
            currentY = currentY + notifHeight + NOTIFICATION_SPACING
        end
    end
end

-- ========= نظام شفافية الإشعارات =========

local function getNotifTransparencyValue()
    if DEDSEC.Save.NotifTransparencyEnabled then
        return (DEDSEC.Save.NotifTransparencyValue or 0) / 100
    end
    return 0
end

local function applyNotifTransparency(notif, baseTransparency)
    if not notif or not notif.Parent then return end
    local t = getNotifTransparencyValue()
    -- باسTransparency هو شفافية الخلفية الأساسية (عادة 0 = ظاهر بالكامل)
    local finalT = baseTransparency + (1 - baseTransparency) * t
    notif.BackgroundTransparency = finalT
    notif:SetAttribute("BaseTransparency", baseTransparency)
end

local function refreshAllNotifTransparency()
    for _, notif in ipairs(activeNotifications) do
        if notif and notif.Parent then
            local base = notif:GetAttribute("BaseTransparency") or 0
            applyNotifTransparency(notif, base)
        end
    end
end
-- ========= نهاية نظام شفافية الإشعارات =========

local function cleanupNotifGlows()
    for i = #notifGlowList, 1, -1 do
        local data = notifGlowList[i]
        if not data.instance or not data.instance.Parent then
            if data.updater then data.updater:Disconnect() end
            table.remove(notifGlowList, i)
        end
    end
end
task.spawn(function()
    while true do
        task.wait(10)
        cleanupNotifGlows()
    end
end)

-- دالة لتحديث إشعار واحد بناءً على الإعدادات الحالية

local function RefreshNotification(notif)
    if not notif or not notif.Parent then return end
    
    -- 1. حساب الإعدادات الحالية
    local sizeConfig = (notifSizeMap and notifSizeMap[currentNotifSize]) or {
        width = 220, height = 90, titleSize = 13, msgSize = 12, imgSize = 48, padding = 10
    }
    sizeConfig = {
        width = sizeConfig.width,
        height = sizeConfig.height,
        titleSize = calcNotifTextSize(sizeConfig.titleSize, sizeConfig.titleMin or 8, sizeConfig.titleMax or 28),
        msgSize = calcNotifTextSize(sizeConfig.msgSize, sizeConfig.msgMin or 7, sizeConfig.msgMax or 26),
        imgSize = sizeConfig.imgSize,
        padding = sizeConfig.padding,
        titleMin = sizeConfig.titleMin or 8,
        titleMax = sizeConfig.titleMax or 28,
        msgMin = sizeConfig.msgMin or 7,
        msgMax = sizeConfig.msgMax or 26,
    }
    local newWidth = sizeConfig.width
    local newHeight = sizeConfig.height
    
    -- 2. تحديث حجم الإشعار
    notif.Size = UDim2.new(0, newWidth, 0, newHeight)
    
    -- 3. تحديث الظل
    local shadow = notif:FindFirstChild("NotifShadow")
    if shadow then
        shadow.Size = UDim2.new(0, newWidth + 45, 0, newHeight + 45)
    end
    
-- 4. تحديث العنوان
    local titleLabel = notif:FindFirstChild("TitleLabel")
    if titleLabel then
        local dynamicTitleHeight = math.floor(newHeight * 0.27)
        titleLabel.Size = UDim2.new(1, -10, 0, dynamicTitleHeight)
        titleLabel.TextSize = sizeConfig.titleSize
        local customTitle = notif:GetAttribute("CustomTitle")
        if customTitle and customTitle == "DEDSEC Message" then
            titleLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
        else
            titleLabel.TextColor3 = currentTextColorObject
        end
        DEDSEC.applyTextStyle(titleLabel)
        -- تحديث لون الـ gradient الموجود مباشرة بدل إنشاء جديد
        local grad = titleLabel:FindFirstChildOfClass("UIGradient")
        if grad then
            -- gradient موجود، لا نعيد إنشاءه فقط نتركه
        else
            DEDSEC.applyGlowToText(titleLabel)
        end
    end
    
    -- 5. تحديث الخط الفاصل
    local divider = notif:FindFirstChild("Divider")
    if divider then
        local dynamicTitleHeight = math.floor(newHeight * 0.27)
        divider.Position = UDim2.new(0, 5, 0, dynamicTitleHeight + 3)
    end
    
    -- 6. تحديث محتوى الإطار
    local contentFrame = notif:FindFirstChild("ContentFrame")
    if contentFrame then
        local dynamicTitleHeight = math.floor(newHeight * 0.27)
        contentFrame.Size = UDim2.new(1, 0, 1, -(dynamicTitleHeight + 8))
        contentFrame.Position = UDim2.new(0, 0, 0, dynamicTitleHeight + 8)
    end
    
    -- 7. تحديث صورة اللاعب وإطارها اللامع (تحسين)
    local playerImage = contentFrame and contentFrame:FindFirstChild("PlayerImage")
    if playerImage then
        playerImage.Size = UDim2.new(0, sizeConfig.imgSize, 0, sizeConfig.imgSize)
        playerImage.Position = UDim2.new(0, sizeConfig.padding, 0.5, -(sizeConfig.imgSize / 2))
        local corner = playerImage:FindFirstChildOfClass("UICorner")
        if corner then
            corner.CornerRadius = UDim.new(0, math.floor(sizeConfig.imgSize * 0.15))
        end
        playerImage.ImageColor3 = Color3.fromRGB(255, 255, 255)
        DEDSEC.applyGlowToIcon(playerImage)
        -- البحث عن الإطار اللامع الخاص بالصورة (الذي تم إنشاؤه بواسطة createNotifGlow)
        local imgGlow = playerImage:FindFirstChild("NotifDynamicGlow")
        if not imgGlow then
            imgGlow = playerImage:FindFirstChildOfClass("UIStroke")
        end
        if imgGlow then
            local glowColor = (window and window._getCurrentGlowColor and window._getCurrentGlowColor()) or Theme["Color Theme"]
            imgGlow.Color = glowColor
            imgGlow.Enabled = DEDSEC.Save.GlowBorderEnabled
            local grad = imgGlow:FindFirstChildOfClass("UIGradient")
            if grad then
                grad.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
                    ColorSequenceKeypoint.new(0.5, glowColor),
                    ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))
                })
            end
        end
    end
    
-- 8. تحديث الرسالة النصية (تحسين)
    local messageLabel = contentFrame and contentFrame:FindFirstChild("MessageLabel")
    if messageLabel then
        local hasImage = playerImage and true or false
        local imgOffset = hasImage and (sizeConfig.imgSize + sizeConfig.padding * 2 + 4) or sizeConfig.padding
        messageLabel.Size = UDim2.new(1, -(imgOffset + sizeConfig.padding), 1, -6)
        messageLabel.Position = UDim2.new(0, imgOffset, 0, 3)
        messageLabel.TextColor3 = currentTextColorObject
        messageLabel.TextScaled = false
        messageLabel.TextSize = sizeConfig.msgSize
        messageLabel.Font = Enum.Font.SourceSansBold
        -- تحديث UITextSizeConstraint للرسالة (واحدة فقط)
        local msgConstraint = messageLabel:FindFirstChildOfClass("UITextSizeConstraint")
        if not msgConstraint then
            msgConstraint = Instance.new("UITextSizeConstraint")
            msgConstraint.Parent = messageLabel
        end
        msgConstraint.MinTextSize = sizeConfig.msgMin
        msgConstraint.MaxTextSize = sizeConfig.msgMax
        DEDSEC.applyTextStyle(messageLabel)
    end
    
-- 9. تحديث زر الإغلاق
    local closeButton = notif:FindFirstChild("CloseButton")
    if closeButton then
        local dynamicTitleHeight = math.floor(newHeight * 0.27)
        local closeBtnSize = math.floor(dynamicTitleHeight * 0.8)
        closeButton.Size = UDim2.new(0, closeBtnSize, 0, closeBtnSize)
        closeButton.Position = UDim2.new(1, -(closeBtnSize + 4), 0, 2)
        closeButton.ImageColor3 = currentTextColorObject
    end
    
-- 10. تحديث خلفية الإشعار
    notif.BackgroundColor3 = Theme["Color Hub 2"]
    applyNotifTransparency(notif, notif:GetAttribute("BaseTransparency") or 0)
    -- 11. تحديث الإطار اللامع الرئيسي للإشعار
    local glowStroke = notif:FindFirstChildOfClass("UIStroke")
    if glowStroke then
        local glowColor = (window and window._getCurrentGlowColor and window._getCurrentGlowColor()) or Theme["Color Theme"]
        glowStroke.Color = glowColor
        glowStroke.Enabled = DEDSEC.Save.GlowBorderEnabled
        local grad = glowStroke:FindFirstChildOfClass("UIGradient")
        if grad then
            grad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
                ColorSequenceKeypoint.new(0.5, glowColor),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))
            })
        end
    end
end

-- دالة لتحديث جميع الإشعارات النشطة
function RefreshAllNotifications()
    -- تحديث جميع الإشعارات (تشمل اشعار التطابق لأنه مضاف في القائمة)
    for _, notif in ipairs(activeNotifications) do
        if notif and notif.Parent then
            -- اشعار التطابق له اسم مختلف، نحدّثه بطريقة خاصة
            if notif.Name == "VictimSelection" then
                local sizeConf = notifSizeMap[currentNotifSize] or notifSizeMap["متوسط"]
                local newSelW = sizeConf.width
                notif.BackgroundColor3 = Theme["Color Hub 2"]
                notif.Size = UDim2.new(0, newSelW, 0, notif.Size.Y.Offset)
                -- تحديث عرض ScrollFrame أيضاً
                local scrollF = notif:FindFirstChildOfClass("ScrollingFrame")
                if scrollF then
                    scrollF.ScrollBarImageColor3 = Theme["Color Theme"]
                end
                -- تحديث جميع العناصر الداخلية
                for _, child in ipairs(notif:GetDescendants()) do
                    if child:IsA("TextLabel") then
                        child.TextColor3 = currentTextColorObject
                        child.TextSize = sizeConf.msgSize
                        DEDSEC.applyTextStyle(child)
                    end
                    -- أيقونة الإغلاق (ImageButton)
                    if child:IsA("ImageButton") and child.Name == "CloseButton" then
                        child.ImageColor3 = currentTextColorObject
                        -- تحديث gradient الخاص به إن وجد
                        local grad = child:FindFirstChildOfClass("UIGradient")
                        if grad then
                            grad.Color = ColorSequence.new({
                                ColorSequenceKeypoint.new(0, Color3.fromRGB(180,180,180)),
                                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255,255,255)),
                                ColorSequenceKeypoint.new(1, Color3.fromRGB(180,180,180))
                            })
                        end
                    end
                    if child:IsA("ImageLabel") then
                        -- لا نغير لون صور اللاعبين داخل الصفوف
                        if child.Parent and child.Parent:IsA("TextButton") then
                            -- هذه صورة لاعب داخل صف، لا نغير لونها
                        else
                            child.ImageColor3 = currentTextColorObject
                        end
                    end
                    if child:IsA("UIStroke") then
                        local glowCol = (window and window._getCurrentGlowColor and window._getCurrentGlowColor()) or Theme["Color Theme"]
                        child.Color = glowCol
                        child.Enabled = DEDSEC.Save.GlowBorderEnabled
                        local grad = child:FindFirstChildOfClass("UIGradient")
                        if grad then
                            grad.Color = ColorSequence.new({
                                ColorSequenceKeypoint.new(0, Color3.fromRGB(0,0,0)),
                                ColorSequenceKeypoint.new(0.5, glowCol),
                                ColorSequenceKeypoint.new(1, Color3.fromRGB(0,0,0))
                            })
                        end
                    end
                end
            else
                RefreshNotification(notif)
            end
        end
    end

    repositionNotifications()
    
    -- تحديث خلفية الصورة العامة
    if UIRefs.windowBackgroundImage and not DEDSEC.Save.LockBackgroundImageColor then
        local bgColor = (backgroundImageColorMode == "تلقائي") and currentTextColorObject or DEDSEC.getColorFromName(backgroundImageColorMode) or currentTextColorObject
        UIRefs.windowBackgroundImage.ImageColor3 = bgColor
    end
    if UIRefs.externalCornerImage and not DEDSEC.Save.LockExternalImageColor then
        local extColor = (externalImageColorMode == "تلقائي") and currentTextColorObject or DEDSEC.getColorFromName(externalImageColorMode) or currentTextColorObject
        UIRefs.externalCornerImage.ImageColor3 = extColor
    end
    
    -- تحديث الإطارات اللامعة لجميع الإشعارات عبر updateGlowColor
    -- هذا يضمن تحديث جميع الإطارات بما فيها إطار الصورة
    local currentGlow = (window and window._getCurrentGlowColor and window._getCurrentGlowColor()) or Theme["Color Theme"]
    if window and window._updateGlowColor then
        window._updateGlowColor(currentGlow)
    end
end

