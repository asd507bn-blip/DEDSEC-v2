-- Heartbeat مركزي واحد لكل الـ Glow
local _globalGlowRotation = 0
local _globalGlowHeartbeat = nil
local _currentlyOpenColorPicker = nil

-- أي UIStroke داخل الـ CoreGui عنده UIGradient و Enabled = true نعتبره "إطار لامع" ونحرّكه
-- (لا نعتمد على الاسم لأن بعض الإطارات ما عندها اسم محدد)

local function _scanAllGlowGradients()
    -- نلمّ كل الـ UIGradients داخل أي UIStroke لامع موجود في الـ CoreGui
    local result = {}
    local seen = {}
    -- أولاً: المسجّلة في الجدول المركزي
    for _, data in pairs(UIRefs.glowStrokes) do
        if data and data.gradient and data.stroke and data.stroke.Parent and not seen[data.gradient] then
            result[#result+1] = { gradient = data.gradient, stroke = data.stroke }
            seen[data.gradient] = true
        end
    end
    -- ثانياً: نمشي على كل الـ ScreenGuis داخل الـ CoreGui (الرئيسي + الإشعارات + أي شيء ثاني)
    pcall(function()
        for _, gui in ipairs(CoreGui:GetChildren()) do
            if gui:IsA("ScreenGui") or gui:IsA("Folder") or gui:IsA("Frame") then
                for _, obj in ipairs(gui:GetDescendants()) do
                    if obj:IsA("UIStroke") and obj.Enabled and obj.Parent then
                        local grad = obj:FindFirstChildOfClass("UIGradient")
                        if grad and not seen[grad] then
                            -- نتجاهل الـ UIStroke العادي (اللي ما عنده UIGradient = border عادي)
                            -- ونلتقط كل UIStroke عنده UIGradient (هذا هو الإطار اللامع)
                            result[#result+1] = { gradient = grad, stroke = obj }
                            seen[grad] = true
                        end
                    end
                end
            end
        end
    end)
    return result
end

local _cachedGlows = nil
local _cachedGlowsTick = 0

local function startGlobalGlowHeartbeat()
    if _globalGlowHeartbeat then return end
    _globalGlowHeartbeat = RunService.Heartbeat:Connect(function()
        _globalGlowRotation = (_globalGlowRotation + 4) % 360
        -- نحدّث الكاش كل 15 فريم (أسرع من قبل) عشان نلتقط عناصر جديدة بسرعة
        _cachedGlowsTick = _cachedGlowsTick + 1
        if _cachedGlowsTick >= 15 or _cachedGlows == nil then
            _cachedGlows = _scanAllGlowGradients()
            _cachedGlowsTick = 0
        end
        for _, entry in ipairs(_cachedGlows) do
            if entry.gradient and entry.gradient.Parent and entry.stroke and entry.stroke.Parent and entry.stroke.Enabled then
                entry.gradient.Rotation = _globalGlowRotation
            end
        end
    end)
end



local function stopGlobalGlowHeartbeat()
    if _globalGlowHeartbeat then
        _globalGlowHeartbeat:Disconnect()
        _globalGlowHeartbeat = nil
    end
    _cachedGlows = nil
    _cachedGlowsTick = 0
end
