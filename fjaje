    -- الفكرة: نحسب أقصى حجم خط يمكن أن "يدخل" فعلياً داخل المساحة الثابتة للإطار
    -- (عرض وارتفاع الإطار لا يتغيران، فقط حجم الخط يتكيف بحيث لا يخرج النص أبداً)
    -- ثم نضيف "تخميد" (lerp) حتى يكون التغيّر تدريجي وليس قفزة مفاجئة.

    local victimSmoothFactor = 1 -- العامل الحالي بعد التخميد (يبدأ متعادل)
    local victimSmoothConnection = nil

local function computeRawScaleFactor()
        local w = MainFrame.AbsoluteSize.X
        if w <= 0 then w = MainFrame.Size.X.Offset end
        if w <= 0 then w = 500 end
        -- نعتمد فقط على عرض الواجهة، الارتفاع لا يؤثر على حجم هذه النصوص
        local BASE_W = 500
        local raw = w / BASE_W
        return math.clamp(raw, 0.6, 2.0)
    end

    -- يحسب أقصى حجم خط يدخل فعلياً ضمن مساحة (width x height) معطاة لعنصر نصي معين
    -- باستخدام TextService:GetTextSize بشكل تقريبي تنازلي
    local TextService = game:GetService("TextService")
    
local function fitTextSizeToBounds(label, candidateMax, minAllowed)
        if not label or not label.Parent then return candidateMax end
        local boundsX = label.AbsoluteSize.X
        local boundsY = label.AbsoluteSize.Y
        if boundsX <= 0 or boundsY <= 0 then return candidateMax end

        local text = label.Text
        if not text or text == "" then return candidateMax end

        local size = candidateMax
        while size > minAllowed do
            local ok, textSize = pcall(function()
                return TextService:GetTextSize(text, size, label.Font, Vector2.new(boundsX, 10000))
            end)
            if ok then
                -- إذا النص (بدون التفاف، سطر واحد) يدخل ضمن العرض المتاح، يكفي
                if textSize.X <= boundsX then
                    return size
                end
            else
                return size
            end
            size = size - 1
        end
        return minAllowed
    end

    function Window:UpdateVictimTextLimits(instantApply)
        local rawFactor = computeRawScaleFactor()

        -- تخميد التغيير: يتحرك العامل الحالي تدريجياً نحو القيمة المستهدفة بدل القفز المباشر
        if victimSmoothConnection then
            victimSmoothConnection:Disconnect()
            victimSmoothConnection = nil
        end

local function applyWithFactor(factor)
            -- الحدود الأساسية لكل عنصر (Min ثابت دائماً، Max يتغير حسب factor)
            local targets = {
                {ref = "VictimName",       baseMax = 26, minSize = 10, hardCap = 48, offset = 2},
                {ref = "VictimInfoText",   baseMax = 16, minSize = 8,  hardCap = 30, offset = 0},
                {ref = "VictimTimerLabel", baseMax = 18, minSize = 9,  hardCap = 32, offset = 0},
            }

            for _, t in ipairs(targets) do
                local label = UIRefs[t.ref]
                if label then
                    local constraint = label:FindFirstChildOfClass("UITextSizeConstraint")
                    if not constraint then
                        constraint = Instance.new("UITextSizeConstraint")
                        constraint.Parent = label
                    end
                    constraint.MinTextSize = t.minSize

                    -- الحد الأقصى "المرغوب" حسب حجم الواجهة
                    local desiredMax = math.floor(math.clamp(t.baseMax * factor, t.minSize, t.hardCap))

                    -- نتأكد إن هذا الحد الأقصى فعلياً ما يخلي النص يخرج عن مساحة الإطار الثابتة
                    local safeMax = fitTextSizeToBounds(label, desiredMax, t.minSize)
                    safeMax = math.max(safeMax, t.minSize)

                    constraint.MaxTextSize = safeMax

                    -- إعادة ضبط الحجم الحالي ضمن الحدود الجديدة (مع مراعاة حجم النص العام المختار)
                    local desiredCurrent = math.clamp(currentTextSize + t.offset, constraint.MinTextSize, constraint.MaxTextSize)
                    label.TextSize = desiredCurrent
                end
            end
        end

        if instantApply then
            victimSmoothFactor = rawFactor
            applyWithFactor(victimSmoothFactor)
            return
        end

        -- تحريك تدريجي (تخميد) نحو rawFactor خلال جزء من الثانية
        local startFactor = victimSmoothFactor
        local duration = 0.25
        local startTime = tick()
        victimSmoothConnection = RunService.Heartbeat:Connect(function()
            local alpha = math.clamp((tick() - startTime) / duration, 0, 1)
            -- تخفيف الحركة (ease out) حتى تكون التغييرات الصغيرة سلسة
            local eased = 1 - (1 - alpha) ^ 2
            victimSmoothFactor = startFactor + (rawFactor - startFactor) * eased
            applyWithFactor(victimSmoothFactor)
            if alpha >= 1 then
                if victimSmoothConnection then
                    victimSmoothConnection:Disconnect()
                    victimSmoothConnection = nil
                end
            end
        end)
    end

