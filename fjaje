local victimTimerRunning = false
local victimEnterCount = 0
local victimExitCount = 0
local victimTimerConnection = nil
-- متغير لتتبع هل الضحية موجودة حالياً (لمنع الاستدعاء المزدوج)
local victimCurrentlyPresent = false




local function formatVictimTime(seconds)
    seconds = math.floor(seconds)
    local d = math.floor(seconds / 86400)
    seconds = seconds % 86400
    local h = math.floor(seconds / 3600)
    seconds = seconds % 3600
    local m = math.floor(seconds / 60)
    local s = seconds % 60
    return string.format("Time %02dd %02dh %02dm %02ds", d, h, m, s)
end

local function updateVictimTimerDisplay()
    if UIRefs.VictimTimerLabel and UIRefs.VictimTimerLabel.Parent then
        local elapsed = victimTimerAccumulated
        if victimTimerRunning and victimTimerStart then
            elapsed = elapsed + (tick() - victimTimerStart)
        end
        UIRefs.VictimTimerLabel.Text = "دخول " .. victimEnterCount ..
            "  |  خروج " .. victimExitCount ..
            "  |  " .. formatVictimTime(elapsed)
    end
end

local function startVictimTimer()
    if victimTimerRunning then return end
    victimTimerRunning = true
    victimTimerStart = tick()
    if victimTimerConnection then victimTimerConnection:Disconnect() end
    victimTimerConnection = RunService.Heartbeat:Connect(function()
        updateVictimTimerDisplay()
    end)
end

local function stopVictimTimer()
    if not victimTimerRunning then return end
    victimTimerRunning = false
    if victimTimerStart then
        victimTimerAccumulated = victimTimerAccumulated + (tick() - victimTimerStart)
        victimTimerStart = nil
    end
    if victimTimerConnection then
        victimTimerConnection:Disconnect()
        victimTimerConnection = nil
    end
    updateVictimTimerDisplay()
end

local function resetVictimTimer()
    stopVictimTimer()
    victimTimerAccumulated = 0
    victimTimerStart = nil
    victimEnterCount = 0
    victimExitCount = 0
    updateVictimTimerDisplay()
end

UIRefs.startVictimTimer = startVictimTimer
UIRefs.stopVictimTimer = stopVictimTimer
UIRefs.resetVictimTimer = resetVictimTimer
