function toggleSpectate()
    if not checkVictimExists(true) then return end
    if not State.isSpectating then
        local victimPlayer = Players:FindFirstChild(State.currentVictim)
        if victimPlayer and victimPlayer.Character then
            local humanoid = victimPlayer.Character:FindFirstChild("Humanoid")
            if humanoid then
                workspace.CurrentCamera.CameraSubject = humanoid
                State.isSpectating = true
                updateVictimButtonState("spectate", true)
                saveCurrentVictimState()
                if State.spectateConnection then State.spectateConnection:Disconnect() end
                State.spectateConnection = victimPlayer.CharacterAdded:Connect(function(newChar)
                    if State.isSpectating then
                        task.wait(0.5)
                        local newHumanoid = newChar:FindFirstChild("Humanoid")
                        if newHumanoid then workspace.CurrentCamera.CameraSubject = newHumanoid end
                    end
                end)
                Player.CharacterAdded:Connect(function()
                    if State.isSpectating then
                        task.wait(0.8)
                        local victimNow = Players:FindFirstChild(State.currentVictim)
                        if victimNow and victimNow.Character then
                            local vHum = victimNow.Character:FindFirstChild("Humanoid")
                            if vHum then workspace.CurrentCamera.CameraSubject = vHum end
                        end
                    end
                end)
            end
        end
    else
        local localHumanoid = Player.Character and Player.Character:FindFirstChild("Humanoid")
        if localHumanoid then workspace.CurrentCamera.CameraSubject = localHumanoid
        else workspace.CurrentCamera.CameraSubject = Player.Character end
        workspace.CurrentCamera.CameraType = Enum.CameraType.Follow
        State.isSpectating = false
        updateVictimButtonState("spectate", false)
        saveCurrentVictimState()
        if State.spectateConnection then State.spectateConnection:Disconnect(); State.spectateConnection = nil end
    end
end

