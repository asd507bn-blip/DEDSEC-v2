    local function protectJumpSpeedCharacter(character)
        local humanoid = character:WaitForChild("Humanoid", 10)
        if not humanoid or not activeFeatures.antiJumpSpeed then return end

        local function checkSpeed()
            if activeFeatures.antiJumpSpeed and humanoid.Parent and humanoid.WalkSpeed < NORMAL_SPEED then
                humanoid.WalkSpeed = NORMAL_SPEED
            end
        end

        local function checkJump()
            if not activeFeatures.antiJumpSpeed or not humanoid.Parent then return end
            if humanoid.UseJumpPower then
                if humanoid.JumpPower <= 0 then
                    humanoid.JumpPower = NORMAL_JUMP_POWER
                end
            elseif humanoid.JumpHeight <= 0 then
                humanoid.JumpHeight = NORMAL_JUMP_HEIGHT
            end
        end

        checkSpeed()
        checkJump()
        table.insert(antiJumpSpeedConnections, humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(checkSpeed))
        table.insert(antiJumpSpeedConnections, humanoid:GetPropertyChangedSignal("JumpPower"):Connect(checkJump))
        table.insert(antiJumpSpeedConnections, humanoid:GetPropertyChangedSignal("JumpHeight"):Connect(checkJump))
        table.insert(antiJumpSpeedConnections, humanoid:GetPropertyChangedSignal("UseJumpPower"):Connect(checkJump))
    end

