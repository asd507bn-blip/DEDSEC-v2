        function Tab:AddColorPicker(Configs)
            local CPName = Configs[1] or Configs.Name or Configs.Title or "لون مخصص"
            local CPDesc = Configs.Desc or Configs.Description or ""
            local Callback = Funcs:GetCallback(Configs, 2)
            local SavedColor = Configs.Default or Color3.fromRGB(255, 255, 255)

            -- تحويل RGB إلى HSV
            local function rgbToHSV(col)
                local r, g, b = col.R, col.G, col.B
                local max, min = math.max(r, g, b), math.min(r, g, b)
                local delta = max - min
                local h = 0
                if delta > 0 then
                    if max == r then
                        h = 60 * (((g - b) / delta) % 6)
                    elseif max == g then
                        h = 60 * (((b - r) / delta) + 2)
                    else
                        h = 60 * (((r - g) / delta) + 4)
                    end
                end
                local s = (max == 0) and 0 or (delta / max)
                local v = max
                return h, s, v
            end

            local function hsvToColor3Local(h, s, v)
                h = h % 360
                local c = v * s
                local x = c * (1 - math.abs((h / 60) % 2 - 1))
                local m = v - c
                local r, g, b
                if h < 60 then r, g, b = c, x, 0
                elseif h < 120 then r, g, b = x, c, 0
                elseif h < 180 then r, g, b = 0, c, x
                elseif h < 240 then r, g, b = 0, x, c
                elseif h < 300 then r, g, b = x, 0, c
                else r, g, b = c, 0, x
