        -- توزيع العمل على عدة فريمات (6 عمليات لكل فريم) لتفادي التجميد
        local CHUNK = 6
        


local function processInChunks(items, processFn)
            for i = 1, #items, CHUNK do
                task.spawn(function()
                    for j = i, math.min(i + CHUNK - 1, #items) do
                        processFn(items[j])
                    end
                end)
                task.wait(0.01)
            end
        end
        processInChunks(pendingButtons, function(obj)
            if enable then
                createGlowForButton(obj, 1.2)
            else
                removeGlowFromButton(obj)
            end
        end)
        processInChunks(pendingStrokes, function(obj)
            pcall(function() obj.Enabled = enable end)
        end)
        if UIRefs.minimizeButtonInstance then
            if enable and DEDSEC.Save.MinimizeButtonGlowEnabled then
                if not UIRefs.minimizeButtonInstance:FindFirstChild("MinimizeButtonGlow") then
                    local stroke = Instance.new("UIStroke")
                    stroke.Name = "MinimizeButtonGlow"
                    stroke.Color = currentGlowColor
                    stroke.Thickness = 1.5
                    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                    stroke.Parent = UIRefs.minimizeButtonInstance
                    local gradient = Instance.new("UIGradient")
                    gradient.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
                        ColorSequenceKeypoint.new(0.5, currentGlowColor),
                        ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))
                    })
                    gradient.Rotation = 0
                    gradient.Parent = stroke
                    UIRefs.minimizeButtonGlowData = { stroke = stroke, gradient = gradient }
                end
            else
                if UIRefs.minimizeButtonGlowData then
                    if UIRefs.minimizeButtonGlowData.updater then UIRefs.minimizeButtonGlowData.updater:Disconnect() end
                    if UIRefs.minimizeButtonGlowData.stroke then UIRefs.minimizeButtonGlowData.stroke:Destroy() end
                    UIRefs.minimizeButtonGlowData = nil
                end
            end
        end
        for _, container in ipairs(ContainerList) do
            for _, obj in ipairs(container:GetDescendants()) do
                if obj:IsA("UIStroke") and obj.Name == "DynamicGlowStroke" then
                    obj.Enabled = enable
                end
            end
        end
        for _, dData in ipairs(discordInviteGlowList) do
            if dData and dData.frame then
                if enable then
                    -- إذا الـ stroke موجود بس معطل فعّله مباشرة
                    if dData.stroke and dData.stroke.Parent then
                        dData.stroke.Enabled = true
                        dData.stroke.Color = currentGlowColor
                        if dData.gradient then
                            dData.gradient.Color = ColorSequence.new({
                                ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
                                ColorSequenceKeypoint.new(0.5, currentGlowColor),
                                ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))
                            })
                        end
                    elseif not dData.frame:FindFirstChild("DiscordInviteGlow") then
                        local stroke = Instance.new("UIStroke")
                        stroke.Name = "DiscordInviteGlow"
                        stroke.Color = currentGlowColor
                        stroke.Thickness = 1.5
                        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                        stroke.Parent = dData.frame
                        local gradient = Instance.new("UIGradient")
                        gradient.Color = ColorSequence.new({
                            ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
                            ColorSequenceKeypoint.new(0.5, currentGlowColor),
                            ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))
                        })
                        gradient.Rotation = 0
                        gradient.Parent = stroke
                        dData.stroke = stroke
                        dData.gradient = gradient
                    else
                        local existing = dData.frame:FindFirstChild("DiscordInviteGlow")
                        if existing then existing.Enabled = true end
                    end
                else
                    if dData.stroke then
                        dData.stroke.Enabled = false
                    end
                end
            end
        end
        for _, data in ipairs(dialogGlows) do
            if enable then
                if not data.stroke then
                    local stroke = Instance.new("UIStroke")
                    stroke.Name = "DialogGlow"
                    stroke.Color = currentGlowColor
                    stroke.Thickness = 1.8
                    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                    stroke.Parent = data.frame
                    local gradient = Instance.new("UIGradient")
                    gradient.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
                        ColorSequenceKeypoint.new(0.5, currentGlowColor),
                        ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))
                    })
                    gradient.Rotation = 0
                    gradient.Parent = stroke
                    data.stroke = stroke
                    data.gradient = gradient
                else
                    data.stroke.Color = currentGlowColor
                    if data.gradient then
                        data.gradient.Color = ColorSequence.new({
                            ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
                            ColorSequenceKeypoint.new(0.5, currentGlowColor),
                            ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))
                        })
                    end
                end
            else
                if data.stroke then
                    if data.updater then data.updater:Disconnect() end
                    data.stroke:Destroy()
                    data.stroke = nil
                    data.gradient = nil
                    data.updater = nil
                end
            end
        end
    end

