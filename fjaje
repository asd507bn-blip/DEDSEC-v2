    local function IsTitle(gui)
        if not gui:IsA("BillboardGui") then return false end
        if gui.Adornee then
            return gui.Adornee.Name == "Head"
        end
        return gui.Parent and gui.Parent.Name == "Head"
    end

    local function HasTitle(character)
        for _, obj in ipairs(character:GetDescendants()) do
            if IsTitle(obj) then return true end
        end
        return false
    end

    local antiTitleIsRemoving = false
    local antiTitlePending = false
    local antiTitleMaxRetries = 3

    local function antiTitleTryRemove()
        if antiTitleIsRemoving then
            antiTitlePending = true
            return
        end
        antiTitleIsRemoving = true
        local character = Player.Character
        if not character then
            antiTitleIsRemoving = false
            return
        end
        task.spawn(function()
            for attempt = 1, antiTitleMaxRetries do
                if not activeFeatures.antiTitle then break end
                executeCommand("untitle")
                task.wait(0.8)
                if not HasTitle(character) then break end
            end
            antiTitleIsRemoving = false
            if antiTitlePending and activeFeatures.antiTitle then
                antiTitlePending = false
                antiTitleTryRemove()
            end
        end)
    end

    local function monitorTitleCharacter(character)
        local function check(obj)
            if IsTitle(obj) then
                antiTitleTryRemove()
            end
        end
        for _, obj in ipairs(character:GetDescendants()) do
            check(obj)
        end
        local conn = character.DescendantAdded:Connect(function(obj)
            task.defer(function()
                if obj.Parent and character == Player.Character and activeFeatures.antiTitle then
                    check(obj)
                end
            end)
        end)
        table.insert(antiTitleDescendantCons, conn)
    end

