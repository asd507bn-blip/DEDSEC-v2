local function calcNotifTextSize(baseSize, minSize, maxSize)
    local textSizeOffset = (currentTextSize or 10) - 10
    return math.clamp(baseSize + textSizeOffset, minSize, maxSize)
end
local currentNotifSize = DEDSEC.Save.NotifSize or "متوسط"

local notifGlowList = {}

local function createNotifGlow(instance, thickness)
    if not instance then return end
    local glowColor = (window and window._getCurrentGlowColor and window._getCurrentGlowColor()) or Theme["Color Theme"] or Color3.fromRGB(88, 101, 242)
    local stroke = Instance.new("UIStroke")
    stroke.Name = "NotifDynamicGlow"
    stroke.Color = glowColor
    stroke.Thickness = thickness or 1.5
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Enabled = DEDSEC.Save.GlowBorderEnabled
    stroke.Parent = instance
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
        ColorSequenceKeypoint.new(0.5, glowColor),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))
    })
    gradient.Rotation = 0
    gradient.Parent = stroke
    local data = { stroke = stroke, gradient = gradient, instance = instance }
    table.insert(notifGlowList, data)
    return data
end

