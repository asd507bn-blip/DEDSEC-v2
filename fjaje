function updateHeadSuck()
    while State.headSucking do
        local localChar = Player.Character
        if not localChar then
            RunService.Heartbeat:Wait()
        else
            local humanoid = localChar:FindFirstChildOfClass("Humanoid")
            if humanoid and State.headSucking then
                humanoid.Sit = true
                if not State.headSuckAnimTrack then
                    local animation = Instance.new("Animation")
                    animation.AnimationId = "rbxassetid://2506281703"
                    State.headSuckAnimTrack = humanoid:LoadAnimation(animation)
                    State.headSuckAnimTrack:Play()
                    State.headSuckAnimTrack:AdjustSpeed(1.5)
                end
            end
            if State.headSuckTargetPlayer and State.headSuckTargetPlayer.Character then
                local humanoidRootPart = localChar:FindFirstChild("HumanoidRootPart")
                local targetHead = State.headSuckTargetPlayer.Character:FindFirstChild("Head")
                if humanoidRootPart and targetHead then
                    if State.headSuckMovingIn then
                        State.headSuckCurrentDistance = State.headSuckCurrentDistance - State.headSuckMovementSpeed
                        if State.headSuckCurrentDistance <= State.headSuckMinDistance then State.headSuckMovingIn = false end
                    else
                        State.headSuckCurrentDistance = State.headSuckCurrentDistance + State.headSuckMovementSpeed
                        if State.headSuckCurrentDistance >= State.headSuckMaxDistance then State.headSuckMovingIn = true end
                    end
                    local faceDirection = targetHead.CFrame.LookVector
                    local targetPosition = targetHead.Position + (faceDirection * State.headSuckCurrentDistance)
                    targetPosition = Vector3.new(targetPosition.X, targetHead.Position.Y, targetPosition.Z)
                    humanoidRootPart.CFrame = CFrame.new(targetPosition, targetHead.Position)
                    humanoidRootPart.Velocity = Vector3.new(0, 2, 0)
                end
            end
            RunService.Heartbeat:Wait()
        end
    end
    local localChar = Player.Character
    if localChar then
        local humanoid = localChar:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid.Sit = false end
    end
    if State.headSuckAnimTrack then
        State.headSuckAnimTrack:Stop()
        State.headSuckAnimTrack = nil
    end
end

