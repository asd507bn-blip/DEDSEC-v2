local function GetPrefix()
    if not hasHDAdmin then return ";" end
    local success, result = pcall(function()
        local gui = Player.PlayerGui:WaitForChild("HDAdminInterface", 3)
        if gui then
            return gui.MainFrame.Pages.Settings.Custom["AE1 Prefix"].SettingValue.TextBox.Text
        end
    end)
    return (success and result and result ~= "" and result) or ";"
end




local function SplitCommands(text)
    local commands = {}
    local keywords = {
        "re", "to", "fly", "unfly", "speed", "jp", "unjp", "jump", "sit", "wormify", "unwormify",
        "dog", "undog", "neon", "unneon", "giantDwarf", "emote", "phase", "aura", "char",
        "size", "height", "colour", "shine", "titlepk", "thin", "worm", "dinofy", "spongify",
        "car", "ratDance", "fakeDeath", "buffify", "cripple", "freeze", "arrest", "kill",
        "bang", "fling", "suspend", "unsuspend", "reset", "autoReset", "stopAll", "autoStopAll"
    }
    local words = string.split(text, " ")
    local current = {}
    for i, word in ipairs(words) do
        if table.find(keywords, word) then
            if #current > 0 then
                table.insert(commands, table.concat(current, " "))
            end
            current = {word}
        else
            table.insert(current, word)
        end
    end
    if #current > 0 then
        table.insert(commands, table.concat(current, " "))
    end
    return commands
end




local function RunCommands(text)
    if not hasHDAdmin then
        showNotification(" 🔴 الماب هذا ليس فيه HD Admin ", nil, false)
        return
    end
    local prefix = GetPrefix()
    local cmds = SplitCommands(text)
    for _, cmd in ipairs(cmds) do
        RequestCommandSilent:InvokeServer(prefix .. cmd)
        task.wait(0.01)
    end
end

function executeCommand(commandText)
    if not commandText or commandText == "" then return end
    if not hasHDAdmin then
        showNotification(" 🔴 الماب هذا ليس فيه HD Admin ", nil, false)
        return
    end
    RunCommands(commandText)
end

