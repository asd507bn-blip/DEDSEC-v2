        }
    end

    local function antiCharNumberDifferent(a, b)
        if a == nil or b == nil then return false end
        return math.abs(a - b) > antiCharSizeTolerance
    end

    local function antiCharVectorDifferent(a, b)
        if not a or not b then return false end
        return antiCharNumberDifferent(a.X, b.X)
            or antiCharNumberDifferent(a.Y, b.Y)
            or antiCharNumberDifferent(a.Z, b.Z)
    end

    local function antiCharColorDifferent(a, b)
        if not a or not b then return false end
        return math.abs(a.R - b.R) > 0.001
            or math.abs(a.G - b.G) > 0.001
            or math.abs(a.B - b.B) > 0.001
    end

    local function antiCharBodySizeChanged()
        if not antiChar.character or not antiChar.normalData then return false end
        for name, normalSize in pairs(antiChar.normalData.BodySizes) do
            local part = antiChar.character:FindFirstChild(name)
            if part and part:IsA("BasePart") then
                if antiCharVectorDifferent(part.Size, normalSize) then
                    return true
                end
            end
        end
        if antiChar.humanoid then
            for name, normalValue in pairs(antiChar.normalData.HumanoidScales) do
                local value = antiChar.humanoid:FindFirstChild(name)
                if value and value:IsA("NumberValue") then
                    if antiCharNumberDifferent(value.Value, normalValue) then
                        return true
                    end
                end
            end
        end
        return false
    end

    local function antiCharClothingChanged()
        if not antiChar.character or not antiChar.normalData then return false end
        local current = antiCharGetClothingData(antiChar.character)
        local normal = antiChar.normalData.Clothing
        if current.Shirt ~= normal.Shirt then return true end
        if current.Pants ~= normal.Pants then return true end
        if current.ShirtGraphic ~= normal.ShirtGraphic then return true end
        return false
    end

    local function antiCharSkinColorChanged()
        if not antiChar.character or not antiChar.normalData then return false end
        local current = antiCharGetBodyColorsData(antiChar.character)
        local normal = antiChar.normalData.BodyColors
        if not current or not normal then return current ~= normal end
        if antiCharColorDifferent(current.HeadColor, normal.HeadColor) then return true end
        if antiCharColorDifferent(current.LeftArmColor, normal.LeftArmColor) then return true end
        if antiCharColorDifferent(current.RightArmColor, normal.RightArmColor) then return true end
        if antiCharColorDifferent(current.LeftLegColor, normal.LeftLegColor) then return true end
        if antiCharColorDifferent(current.RightLegColor, normal.RightLegColor) then return true end
        if antiCharColorDifferent(current.TorsoColor, normal.TorsoColor) then return true end
        return false
    end

    local function antiCharFaceChanged()
        if not antiChar.character or not antiChar.normalData then return false end
        local currentFace = antiCharGetFaceData(antiChar.character)
        return currentFace ~= antiChar.normalData.Face
    end

    local function antiCharCharacterChanged()
        if not antiChar.character or not antiChar.normalData then return false end
        if antiCharBodySizeChanged() then return true end
        if antiCharClothingChanged() then return true end
        if antiCharSkinColorChanged() then return true end
        if antiCharFaceChanged() then return true end
        return false
    end

    local function antiCharHandleDetection()
        if not antiChar.active or antiChar.fixing or antiChar.retryCooldown then return end
        antiChar.fixing = true
        local generation = antiChar.generation
        antiCharExecuteUnchar()
        local attempts = 1
        local restored = false

        while antiChar.active and generation == antiChar.generation do
            task.wait(antiCharVerifyInterval)
            if not antiChar.active or generation ~= antiChar.generation then break end
            if not antiChar.character or not antiChar.humanoid or not antiChar.normalData then
                -- انتظار
            else
                if not antiCharCharacterChanged() then
                    restored = true
                    break
                end
                if attempts >= antiCharMaxUncharAttempts then break end
                task.wait(antiCharRetryDelay)
                if not antiChar.active or generation ~= antiChar.generation then break end
                antiCharExecuteUnchar()
                attempts += 1
            end
        end

        antiChar.fixing = false
        if not restored and attempts >= antiCharMaxUncharAttempts and generation == antiChar.generation then
            antiChar.retryCooldown = true
            task.delay(antiCharCooldownTime, function()
                antiChar.retryCooldown = false
            end)
        end
    end

    local function antiCharSetupCharacter(character)
        if not antiChar.active then return end
        antiChar.generation = antiChar.generation + 1
        local generation = antiChar.generation
        antiChar.character = character
        antiChar.humanoid = nil
        antiChar.fixing = false
        antiChar.retryCooldown = false

        if not character then return end

        local humanoid = character:WaitForChild("Humanoid", 10)
        if not antiChar.active or generation ~= antiChar.generation then return end
        if not humanoid then return end
        antiChar.humanoid = humanoid

        local startTime = os.clock()
        while os.clock() - startTime < antiCharCharacterLoadTime do
            if not antiChar.active or generation ~= antiChar.generation then return end
            if Player.Character ~= character then return end
            task.wait(0.05)
        end

        if not antiChar.active or generation ~= antiChar.generation then return end
        if Player.Character ~= character then return end

        if not antiChar.normalData then
            local captured = antiCharCaptureNormalData(character)
            if captured then
                antiChar.normalData = captured
                antiChar.normalDataLocked = true
                print("[Anti-Char] Original character saved")
            end
        else
            if antiChar.normalDataLocked then
                task.wait(0.25)
                if not antiChar.active or generation ~= antiChar.generation then return end
                if antiCharCharacterChanged() then
                    if not antiChar.fixing and not antiChar.retryCooldown then
                        task.spawn(antiCharHandleDetection)
                    end
                end
            end
        end
    end

    local function startAntiChar()
        if antiChar.active then return end
        if not RequestCommandSilent then
            local result = getHDAdminSignal()
            if result then
                RequestCommandSilent = result
                hasHDAdmin = true
            end
        end
        if not RequestCommandSilent then
            warn("[Anti-Char] RequestCommandSilent not found")
            return
        end

        antiChar.active = true
        antiChar.character = nil
        antiChar.humanoid = nil
        antiChar.normalData = nil
        antiChar.normalDataLocked = false
        antiChar.fixing = false
        antiChar.retryCooldown = false
        antiChar.generation = 0
        antiChar.connections = {}
        antiChar.threads = {}

        -- CharacterAdded
        local charConn = Player.CharacterAdded:Connect(function(character)
            if antiChar.active then
                task.spawn(function()
                    antiCharSetupCharacter(character)
                end)
            end
        end)
        table.insert(antiChar.connections, charConn)

        -- initial character
        if Player.Character then
            task.spawn(function()
                antiCharSetupCharacter(Player.Character)
            end)
        end

        -- monitor character switch
        local monitorThread = task.spawn(function()
            while antiChar.active do
                task.wait(0.05)
                if not antiChar.active then break end
                local current = Player.Character
                if current and current ~= antiChar.character then
                    task.spawn(function()
                        antiCharSetupCharacter(current)
                    end)
                end
            end
        end)
        table.insert(antiChar.threads, monitorThread)

        -- continuous monitor
        local loopThread = task.spawn(function()
            while antiChar.active do
                task.wait(antiCharCheckInterval)
                if not antiChar.active then break end
                if Player.Character ~= antiChar.character then
                    -- skip
                else
                    if antiChar.character and antiChar.humanoid and antiChar.normalData
                        and not antiChar.fixing and not antiChar.retryCooldown then
                        if antiCharCharacterChanged() then
                            task.spawn(antiCharHandleDetection)
                        end
                    end
                end
            end
        end)
        table.insert(antiChar.threads, loopThread)

        -- part connections monitor
        local partConnectThread = task.spawn(function()
            while antiChar.active do
                task.wait(0.1)
                if not antiChar.active then break end
                if antiChar.character and antiChar.character == Player.Character then
                    for _, object in ipairs(antiChar.character:GetDescendants()) do
                        if object:IsA("BasePart") and not object:GetAttribute("AntiCharConnected") then
                            object:SetAttribute("AntiCharConnected", true)
                            local conn = object:GetPropertyChangedSignal("Size"):Connect(function()
                                if antiChar.active and not antiChar.fixing and not antiChar.retryCooldown
                                    and antiChar.normalData and antiChar.character == Player.Character then
                                    if antiCharCharacterChanged() then
                                        task.spawn(antiCharHandleDetection)
                                    end
                                end
                            end)
                            table.insert(antiChar.connections, conn)
                        end
                    end
                end
            end
        end)
        table.insert(antiChar.threads, partConnectThread)
    end

    local function stopAntiChar()
        antiChar.active = false
        for _, conn in ipairs(antiChar.connections) do
            pcall(function() conn:Disconnect() end)
        end
        antiChar.connections = {}
        for _, thread in ipairs(antiChar.threads) do
            pcall(function() task.cancel(thread) end)
        end
        antiChar.threads = {}
        antiChar.character = nil
        antiChar.humanoid = nil
        antiChar.normalData = nil
        antiChar.normalDataLocked = false
        antiChar.fixing = false
        antiChar.retryCooldown = false
    end

