                        Player.Character:SetPrimaryPartCFrame(CFrame.new(targetPart.Position) * offsetCFrame * rotationCFrame)
                        localRoot.Velocity = Vector3.new(90000000, 900000000, 90000000)
                        localRoot.RotVelocity = Vector3.new(900000000, 900000000, 900000000)
                    end
                    
                    if targetRoot.Velocity.Magnitude >= 50 then
                        -- الحركة عند سرعة عالية
                        local movePatterns = {
                            {offset = Vector3.new(0, 1.5, targetHumanoid.WalkSpeed), rotation = math.rad(90)},
                            {offset = Vector3.new(0, -1.5, -targetHumanoid.WalkSpeed), rotation = 0},
                            {offset = Vector3.new(0, 1.5, targetHumanoid.WalkSpeed), rotation = math.rad(90)},
                            {offset = Vector3.new(0, 1.5, targetRoot.Velocity.Magnitude / 1.25), rotation = math.rad(90)},
                            {offset = Vector3.new(0, -1.5, -targetRoot.Velocity.Magnitude / 1.25), rotation = 0},
                            {offset = Vector3.new(0, 1.5, targetRoot.Velocity.Magnitude / 1.25), rotation = math.rad(90)},
                            {offset = Vector3.new(0, -1.5, 0), rotation = math.rad(90)},
                            {offset = Vector3.new(0, -1.5, 0), rotation = 0},
                            {offset = Vector3.new(0, -1.5, 0), rotation = math.rad(-90)},
                            {offset = Vector3.new(0, -1.5, 0), rotation = 0}
                        }
                        
                        while State.flingActive do
                            for _, pattern in ipairs(movePatterns) do
                                if not State.flingActive then break end
                                setPlayerPosition(targetRoot, CFrame.new(pattern.offset), CFrame.Angles(pattern.rotation, 0, 0))
                                task.wait()
                            end
                        end
                    else
                        -- الحركة عند سرعة منخفضة
                        rotationAngle = rotationAngle + 100
                        local movePatterns = {
                            Vector3.new(0, 1.5, 0),
                            Vector3.new(0, -1.5, 0),
                            Vector3.new(2.25, 1.5, -2.25),
                            Vector3.new(-2.25, -1.5, 2.25),
                            Vector3.new(0, 1.5, 0),
                            Vector3.new(0, -1.5, 0)
                        }
                        
                        while State.flingActive do
                            for _, offset in ipairs(movePatterns) do
                                if not State.flingActive then break end
                                local extraOffset = targetHumanoid.MoveDirection * (targetRoot.Velocity.Magnitude / 1.25)
                                setPlayerPosition(targetRoot, CFrame.new(offset) + extraOffset, CFrame.Angles(math.rad(rotationAngle), 0, 0))
                                task.wait()
                            end
                        end
                    end
                    
                    if humanoid then humanoid.Sit = false end
                end
            end
        end)
    until not State.flingActive
    
    if State.flingBodyVelocity then
        State.flingBodyVelocity:Destroy()
        State.flingBodyVelocity = nil
    end
    
    if humanoid then
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
    end
    
    -- إعادة اللاعب إلى موقعه السابق بعد انتهاء الفلنق
    if State.flingOldPos and Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
        local root = Player.Character.HumanoidRootPart
        repeat
            root.CFrame = State.flingOldPos * CFrame.new(0, 0.5, 0)
            Player.Character:SetPrimaryPartCFrame(State.flingOldPos * CFrame.new(0, 0.5, 0))
            if humanoid then humanoid:ChangeState("GettingUp") end
            for _, part in pairs(Player.Character:GetChildren()) do
                if part:IsA("BasePart") then
                    part.Velocity = Vector3.new(0,0,0)
                    part.RotVelocity = Vector3.new(0,0,0)
                end
            end
            task.wait()
        until (root.Position - State.flingOldPos.Position).Magnitude < 25
    end
    
    workspace.FallenPartsDestroyHeight = State.flingOldFPDH
    stopFlingCameraTracking()
    updateVictimButtonState("fling", false)
    State.flingActive = false
    saveCurrentVictimState()
end

