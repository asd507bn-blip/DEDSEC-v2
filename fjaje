local fontOptions = {"افتراضي"}
local fontEnumMap = { ["افتراضي"] = nil }

for _, fontEnum in ipairs(Enum.Font:GetEnumItems()) do
    local name = fontEnum.Name
    table.insert(fontOptions, name)
