    -- مضاد تعليق v1 (يحتاج أدمن) - النسخة المطورة
    local function toggleAntiHangV1(value)
        activeFeatures.antiHangV1 = value
        if value then
            task.spawn(function()
                local excludedPlayers = {}
                local isSearching = false
                local myName = Player.Name:lower()
                local function isValidTarget(p)
                    if p == Player then return false end
                    local pName = p.Name:lower()
                    if pName:match("^nan") then return false end
                    if pName == myName or pName == myName .. "x" then return false end
                    local pChar = p.Character
                    if not pChar then return false end
                    local pRoot = pChar:FindFirstChild("HumanoidRootPart")
                    if not pRoot then return false end
                    local pRay = workspace:Raycast(pRoot.Position, Vector3.new(0, -10, 0))
                    return pRay ~= nil
                end

                local function isMeHanging()
                    local char = Player.Character
                    if not char then return true end
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if not root then return true end
                    local ray = workspace:Raycast(root.Position, Vector3.new(0, -20, 0))
                    return ray == nil
                end

                while activeFeatures.antiHangV1 do
                    if isMeHanging() then
                        if not isSearching then
                            isSearching = true
                            local target = nil
                            for _, p in ipairs(Players:GetPlayers()) do
                                if not excludedPlayers[p] and isValidTarget(p) then
                                    target = p
                                    break
                                end
                            end
                            if target then
                                executeCommand("to " .. target.Name)
                                task.wait(0.8)
                                if isMeHanging() then
                                    excludedPlayers[target] = true
                                else
                                    excludedPlayers = {}
                                end
                                isSearching = false
                            else
                                isSearching = false
                            end
                        end
                    else
                        excludedPlayers = {}
                        isSearching = false
                    end
                    task.wait(0.5)
                end
            end)
        end
    end

