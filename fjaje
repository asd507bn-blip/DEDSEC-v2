    local antiNeonCheckDelay = 0.25
    local antiNeonVerifyDelay = 0.5
    local antiNeonMaxAttempts = 3

    local function antiNeonHasNeon(character)
        if not character or not character.Parent then return false end
        for _, obj in ipairs(character:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Material == Enum.Material.Neon then
                return true
            end
        end
        return false
    end

    local function antiNeonRemoveNeon(character)
        if antiNeonIsProcessing then return end
        if not character or not character.Parent then return end
        if not antiNeonHasNeon(character) then return end
        antiNeonIsProcessing = true
        for attempt = 1, antiNeonMaxAttempts do
            if not antiNeonHasNeon(character) then break end
            executeCommand("unneon")
            task.wait(antiNeonVerifyDelay)
            if not antiNeonHasNeon(character) then break end
            task.wait(antiNeonCheckDelay)
        end
        antiNeonIsProcessing = false
    end

    local function antiNeonDisconnectAll()
        if antiNeonCharAddedConn then
            antiNeonCharAddedConn:Disconnect()
            antiNeonCharAddedConn = nil
        end
        for _, conn in ipairs(antiNeonConnections) do
            conn:Disconnect()
        end
        antiNeonConnections = {}
    end

    local function antiNeonSetupCharacter(character)
        antiNeonDisconnectAll()
        if not character then return end
        task.defer(function()
            if antiNeonHasNeon(character) then
                antiNeonRemoveNeon(character)
            end
        end)
        local conn1 = character.DescendantAdded:Connect(function(obj)
            task.wait(antiNeonCheckDelay)
            if not character.Parent then return end
            if antiNeonHasNeon(character) then
                antiNeonRemoveNeon(character)
            end
        end)
        table.insert(antiNeonConnections, conn1)
        for _, obj in ipairs(character:GetDescendants()) do
            if obj:IsA("BasePart") then
                local conn2 = obj:GetPropertyChangedSignal("Material"):Connect(function()
                    if not character.Parent then return end
                    if obj.Material == Enum.Material.Neon then
                        antiNeonRemoveNeon(character)
                    end
                end)
                table.insert(antiNeonConnections, conn2)
            end
        end
        local conn3 = character.DescendantAdded:Connect(function(obj)
            if not obj:IsA("BasePart") then return end
            local conn4 = obj:GetPropertyChangedSignal("Material"):Connect(function()
                if not character.Parent then return end
                if obj.Material == Enum.Material.Neon then
                    antiNeonRemoveNeon(character)
                end
            end)
            table.insert(antiNeonConnections, conn4)
        end)
        table.insert(antiNeonConnections, conn3)
    end

