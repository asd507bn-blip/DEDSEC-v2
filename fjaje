UIRefs.onVictimEnter = function()
    if victimCurrentlyPresent then return end -- منع الاستدعاء المزدوج
    victimCurrentlyPresent = true
    victimEnterCount = victimEnterCount + 1
    startVictimTimer()
    updateVictimTimerDisplay()
end
UIRefs.onVictimExit = function()
    if not victimCurrentlyPresent then return end -- منع الاستدعاء المزدوج
    victimCurrentlyPresent = false
    victimExitCount = victimExitCount + 1
    stopVictimTimer()
    updateVictimTimerDisplay()
end
