local function trackVictimStatus()
    Players.PlayerRemoving:Connect(function(leavingPlayer)
        -- تأكد إن هذا اللاعب الخارج هو فعلاً الضحية المحددة حالياً، وإنه لم يُسجَّل خروجه من قبل
        if State.currentVictimUserId
            and leavingPlayer.UserId == State.currentVictimUserId
            and State.victimExistsInServer then
            State.SavedStates = getCurrentActiveStates()
            State.SavedUserId = leavingPlayer.UserId
            State.Restored = false
            State.victimExistsInServer = false
            stopAllVictimFeatures(true)
            if UIRefs.onVictimExit then UIRefs.onVictimExit() end
            showNotification("🔴 الضحية " .. leavingPlayer.Name .. " خرج من السيرفر", {
                Image = loadPlayerImage(leavingPlayer.UserId)
            }, true)
        end
    end)
    Players.PlayerAdded:Connect(function(joiningPlayer)
        -- تأكد إنه نفس الضحية المحفوظة، وما زالت محددة حالياً، ولم تُستعاد من قبل
        if State.SavedUserId
            and joiningPlayer.UserId == State.SavedUserId
            and State.currentVictimUserId == State.SavedUserId
            and not State.Restored
            and not State.victimExistsInServer then
            task.spawn(function()
                local char = joiningPlayer.Character or joiningPlayer.CharacterAdded:Wait()
                repeat task.wait() until char and char:FindFirstChild("HumanoidRootPart")
                task.wait(0.5)
                -- تحقق مرة أخرى بعد الانتظار للتأكد إن الحالة لم تتغير أثناء الانتظار
                if State.SavedUserId == joiningPlayer.UserId
                    and State.currentVictimUserId == State.SavedUserId
                    and not State.Restored
                    and not State.victimExistsInServer then
                    applyStatesToCurrentVictim(State.SavedStates)
                    State.Restored = true
                    State.victimExistsInServer = true
                    updateVictimUI(joiningPlayer)
                    if UIRefs.onVictimEnter then UIRefs.onVictimEnter() end
                    showNotification("🟢 الضحية " .. joiningPlayer.Name .. " دخل إلى السيرفر", {
                        Image = loadPlayerImage(joiningPlayer.UserId)
                    }, true)
                end
            end)
        end
    end)
end
