            if targetHRP and playerHRP then
                local t = tick()
                local x = math.sin(t * 30) * 2
                local y = math.cos(t * 15) * 0.5
                local z = math.sin(t * 25) * 2
                local offset = Vector3.new(x, y + 0.5, z)
                local rotation = CFrame.Angles(math.sin(t * 30) * 1.5, math.cos(t * 36) * 2, math.sin(t * 24) * 1.2)
                playerHRP.CFrame = (targetHRP.CFrame * CFrame.new(offset)) * rotation
            end
            if not currentAnimTrack or not currentAnimTrack.IsPlaying then
                currentAnimTrack = playMonsterBangAnimation()
            end
        end
    end)
