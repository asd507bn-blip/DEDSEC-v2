                            end
                        end
                    end
                    return nil
                end
                local function onChildAdded(child)
                    if child:IsA("Weld") and child.Name == "RightGrip" then
                        local matched = toolMatch(child.Part1)
                        if matched then
                            if child.Part1 and child.Part1.Parent then child.Part1.Parent:Destroy() end
