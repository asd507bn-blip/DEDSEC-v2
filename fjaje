                    SVIndicator.Position = UDim2.fromScale(cpSat, 1 - cpVal)
                    updateColorPreview()
                    DEDSEC.ImmediateSave()
                end)
            end


            local draggingHue, draggingSV = false, false

            local function updateHueFromMouse()
                local MousePos = Player:GetMouse()
                local barPos, barSize = HueBar.AbsolutePosition, HueBar.AbsoluteSize
                local relX = math.clamp((MousePos.X - barPos.X) / barSize.X, 0, 1)
                cpHue = relX * 360
                HueIndicator.Position = UDim2.fromScale(relX, 0.5)
                updateColorPreview()
            end

            local function updateSatValFromMouse()
                local MousePos = Player:GetMouse()
                local framePos, frameSize = SatValFrame.AbsolutePosition, SatValFrame.AbsoluteSize
                local relX = math.clamp((MousePos.X - framePos.X) / frameSize.X, 0, 1)
                local relY = math.clamp((MousePos.Y - framePos.Y) / frameSize.Y, 0, 1)
                cpSat = relX
                cpVal = 1 - relY
                SVIndicator.Position = UDim2.fromScale(relX, relY)
                updateColorPreview()
            end

            HueBar.InputBegan:Connect(function(input)
                if draggingHue or draggingSV then return end
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    draggingHue = true
                    Container.ScrollingEnabled = false
                    updateHueFromMouse()
                    while UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
                        task.wait()
                        updateHueFromMouse()
                    end
                    draggingHue = false
                    Container.ScrollingEnabled = true
                    DEDSEC.ImmediateSave()
                end
            end)

            SatValFrame.InputBegan:Connect(function(input)
                if draggingHue or draggingSV then return end
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    draggingSV = true
                    Container.ScrollingEnabled = false
                    updateSatValFromMouse()
                    while UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
                        task.wait()
                        updateSatValFromMouse()
                    end
                    draggingSV = false
                    Container.ScrollingEnabled = true
                    DEDSEC.ImmediateSave()
                end
            end)

            local closeThisPicker
            Frame.Activated:Connect(function()
                if draggingHue or draggingSV then return end
                if not expanded then
                    -- أغلق أي تبويب ألوان آخر مفتوح حالياً قبل فتح هذا
                    if _currentlyOpenColorPicker and _currentlyOpenColorPicker ~= closeThisPicker then
                        _currentlyOpenColorPicker()
                    end
                    expanded = true
                    _currentlyOpenColorPicker = closeThisPicker
                    DEDSEC.CreateTween({Frame, "Size", UDim2.new(1, 0, 0, EXPANDED_H), 0.3})
                else
                    expanded = false
                    if _currentlyOpenColorPicker == closeThisPicker then
                        _currentlyOpenColorPicker = nil
                    end
                    DEDSEC.CreateTween({Frame, "Size", UDim2.new(1, 0, 0, COLLAPSED_H), 0.3})
                end
            end)

            closeThisPicker = function()
                if expanded then
                    expanded = false
                    DEDSEC.CreateTween({Frame, "Size", UDim2.new(1, 0, 0, COLLAPSED_H), 0.3})
                end
            end

            local ColorPicker = {}
            function ColorPicker:Visible(...) Funcs:ToggleVisible(Frame, ...) end
            function ColorPicker:Destroy()
                previewBoxColorConn:Disconnect()
                if _currentlyOpenColorPicker == closeThisPicker then
                    _currentlyOpenColorPicker = nil
                end
                Frame:Destroy()
            end
            function ColorPicker:Callback(...) Funcs:InsertCallback(Callback, ...) end
            function ColorPicker:Get()
                return hsvToColor3Local(cpHue, cpSat, cpVal)
            end
            function ColorPicker:Set(NewColor3)
                if typeof(NewColor3) ~= "Color3" then return end
                cpHue, cpSat, cpVal = rgbToHSV(NewColor3)
                HueIndicator.Position = UDim2.fromScale(cpHue / 360, 0.5)
                SVIndicator.Position = UDim2.fromScale(cpSat, 1 - cpVal)
                updateColorPreview()
            end
            function ColorPicker:SetLocked(locked)
                isAutoMode = locked and true or false
                HueBar.Active = not isAutoMode
                SatValFrame.Active = not isAutoMode
                HueBar.BackgroundTransparency = isAutoMode and 0.5 or 0
                SatValFrame.BackgroundTransparency = isAutoMode and 0.5 or 0
            end
            return ColorPicker
        end

