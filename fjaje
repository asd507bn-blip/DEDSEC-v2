    -- ====== دالة تنفيذ الأوامر ======
    local function executeCommand(cmd)
        if not hasHDAdmin or not RequestCommandSilent then
            return false
        end
        local success, prefix = pcall(function()
            local gui = Player.PlayerGui:FindFirstChild("HDAdminInterface")
            if gui then
                local main = gui:FindFirstChild("MainFrame")
                if main then
                    local pages = main:FindFirstChild("Pages")
                    if pages then
                        local settings = pages:FindFirstChild("Settings")
                        if settings then
                            local custom = settings:FindFirstChild("Custom")
                            if custom then
                                local prefixBox = custom:FindFirstChild("AE1 Prefix")
                                if prefixBox then
                                    local settingVal = prefixBox:FindFirstChild("SettingValue")
                                    if settingVal then
                                        local textBox = settingVal:FindFirstChild("TextBox")
                                        if textBox then
                                            return textBox.Text
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
            return nil
        end)
        local prefix = (success and prefix and prefix ~= "" and prefix) or ";"
        local fullCmd = prefix .. cmd
        pcall(function()
            RequestCommandSilent:InvokeServer(fullCmd)
        end)
        return true
    end

