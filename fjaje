function findPlayerByPartialName(partialName)
    local matches = {}
    partialName = partialName:lower()
    for _, targetPlayer in pairs(Players:GetPlayers()) do
        if targetPlayer.Name:lower() == partialName or targetPlayer.DisplayName:lower() == partialName then
            return targetPlayer
        end
    end
    for _, targetPlayer in pairs(Players:GetPlayers()) do
        if targetPlayer.Name:lower():sub(1, #partialName) == partialName or
           targetPlayer.DisplayName:lower():sub(1, #partialName) == partialName then
            table.insert(matches, targetPlayer)
        end
    end
    if #matches == 1 then
        return matches[1]
    elseif #matches > 1 then
        return nil, matches
    else
        return nil
    end
end

function getAccountAgeInfo(userId)
    local success, result = pcall(function()
        return Players:GetPlayerByUserId(userId).AccountAge
    end)
    if success and result then
        local days = result
        local years = math.floor(days / 365)
        local months = math.floor((days % 365) / 30)
        local remainingDays = days % 30
        return years, months, remainingDays, days
    end
    return 0, 0, 0, 0
end

function calculateCreationDateFromAge(days)
    local currentTime = os.time()
    local creationTime = currentTime - (days * 24 * 60 * 60)
    return os.date("%d/%m/%Y", creationTime)
end

function getVictimTools(victimPlayer)
    local tools = {}
    if victimPlayer and victimPlayer.Character then
        local backpack = victimPlayer:FindFirstChildOfClass("Backpack")
        if backpack then
            for _, tool in ipairs(backpack:GetChildren()) do
                if tool:IsA("Tool") then table.insert(tools, tool.Name) end
            end
        end
        for _, tool in ipairs(victimPlayer.Character:GetChildren()) do
            if tool:IsA("Tool") then table.insert(tools, tool.Name) end
        end
    end
    return tools
end

function formatToolsList(tools)
    if #tools == 0 then return "لا يوجد"
    elseif #tools <= 4 then return table.concat(tools, ", ")
    else return table.concat(tools, ", ", 1, 4) .. " +" .. (#tools - 4) end
end

function updateVictimUI(victimPlayer)
    if UIRefs.VictimName and UIRefs.VictimAvatar and UIRefs.VictimInfoText then
        if victimPlayer then
            UIRefs.VictimName.Text = "الضحية: " .. victimPlayer.Name
            UIRefs.VictimName.TextSize = currentTextSize + 6  -- حجم مناسب
            UIRefs.VictimAvatar.Image = loadPlayerImage(victimPlayer.UserId)
            UIRefs.VictimAvatar.Visible = true
            local displayName = victimPlayer.DisplayName
            local userId = victimPlayer.UserId
            local years, months, remainingDays, totalDays = getAccountAgeInfo(userId)
            local creationDate = calculateCreationDateFromAge(totalDays)
            local tools = getVictimTools(victimPlayer)
            local toolsText = formatToolsList(tools)
            UIRefs.VictimInfoText.Text = string.format(
                "اللقب: %s\nمعرف: %d\nتاريخ الإنشاء: %s\nعمر الحساب: %d يوم\nالأدوات: %s",
                displayName, userId, creationDate, totalDays, toolsText
            )
            UIRefs.VictimInfoText.Visible = true
        else
            UIRefs.VictimName.Text = "لا يوجد ضحية محددة"
            UIRefs.VictimName.TextSize = currentTextSize + 6  -- تصغير النص الافتراضي
            UIRefs.VictimAvatar.Image = "rbxasset://textures/ui/GuiImagePlaceholder.png"
            UIRefs.VictimAvatar.Visible = false
            UIRefs.VictimInfoText.Text = "اللقب: -\nمعرف: -\nتاريخ الإنشاء: -\nعمر الحساب: -\nالأدوات: -"
            UIRefs.VictimInfoText.Visible = false
        end
    end
end

function updateVictimInfo(victimPlayer)
    if victimPlayer then
        if victimPlayer.Name == Player.Name then
            showNotification("🔴 لا يمكنك تحديد نفسك كضحية", nil, false)
            return
        end
        local oldUserId = State.currentVictimUserId
        local activeStates = nil
        if oldUserId and oldUserId ~= victimPlayer.UserId then
            activeStates = getCurrentActiveStates()
            stopAllVictimFeatures(true)
        elseif oldUserId == victimPlayer.UserId then
            return
        end
        State.currentVictim = victimPlayer.Name
        State.currentVictimUserId = victimPlayer.UserId
        State.victimExistsInServer = true
        updateVictimUI(victimPlayer)
 -- إعادة ضبط المؤقت عند تحديد ضحية جديدة أو مختلفة (بدون زيادة عداد الدخول الأول)
    if UIRefs.resetVictimTimerFull then UIRefs.resetVictimTimerFull() end
    if UIRefs.startVictimTimer then
        UIRefs.startVictimTimer()
        if UIRefs.setVictimPresent then UIRefs.setVictimPresent(true) end
    end
        if activeStates then
            applyStatesToCurrentVictim(activeStates)
        else
            applyVictimState(State.currentVictimUserId)
        end
        saveCurrentVictimState()
        showNotification("🟢 تم تحديد الضحية " .. victimPlayer.Name, {
            Image = loadPlayerImage(victimPlayer.UserId)
        }, false)
    else
        if State.currentVictimUserId then
            saveCurrentVictimState()
            stopAllVictimFeatures(false)
        end
        State.currentVictim = nil
        State.currentVictimUserId = nil
        State.victimExistsInServer = false
        updateVictimUI(nil)
    end
end

