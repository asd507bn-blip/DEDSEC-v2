    function DEDSEC .ApplyCurrentThemeToElement(Instance, Type)
    if not Instance or not Type then return end
    local theme = DEDSEC.Themes[DEDSEC.Save.Theme]
    if not theme then return end
    if Type == "Gradient" and Instance:IsA("UIGradient") then
        Instance.Color = theme["Color Hub 1"]
    elseif Type == "Frame" and (Instance:IsA("Frame") or Instance:IsA("TextButton") or Instance:IsA("ImageButton")) then
        if not (Instance:IsA("ImageButton") and Instance.Name == "MinimizeButton") then
            Instance.BackgroundColor3 = theme["Color Hub 2"]
            if Instance.Name ~= "VictimSelectBtn" then
                Instance.BackgroundTransparency = getButtonTabTransparencyValue()
            end
        end
    elseif Type == "Stroke" and Instance:IsA("UIStroke") then
        Instance.Color = theme["Color Stroke"]
    elseif Type == "Theme" then
        if Instance:IsA("Frame") or Instance:IsA("TextButton") then
            Instance.BackgroundColor3 = theme["Color Theme"]
        elseif Instance:IsA("ImageLabel") then
            Instance.ImageColor3 = theme["Color Theme"]
        end
    elseif Type == "Text" then
    if Instance:IsA("ImageLabel") and Instance.Name ~= "AvatarImage" and Instance.Name ~= "DiscordLogo" and Instance.Name ~= "OwnerImage" and Instance.Name ~= "VictimAvatar" and Instance.Name ~= "ExternalCornerImage" and Instance.Name ~= "PlayerImage" then
        if Instance.Name == "WindowBackground" and DEDSEC.Save.LockBackgroundImageColor then
            -- لا تغير لونها
        else
            Instance.ImageColor3 = currentTextColorObject
        end
    elseif Instance:IsA("TextLabel") or Instance:IsA("TextButton") or Instance:IsA("TextBox") then
        Instance.TextColor3 = currentTextColorObject
        DEDSEC.updateTextStyleAndGlow(Instance)
        DEDSEC.hookTextChange(Instance)
    elseif Instance:IsA("ImageButton") then
        if Instance.Name == "MinimizeButton" then
            if MinimizeButtonColorLock then
                Instance.ImageColor3 = Color3.fromRGB(255, 255, 255)
            elseif minimizeButtonIconColorMode == "تلقائي" then
                Instance.ImageColor3 = currentTextColorObject
            else
                local colorMap = ArabicColorMap
                Instance.ImageColor3 = colorMap[minimizeButtonIconColorMode] or currentTextColorObject
            end
        elseif Instance.Name == "CloseButton" then
            Instance.ImageColor3 = Color3.fromRGB(255, 255, 255)
        else
            Instance.ImageColor3 = currentTextColorObject
        end
    end
    elseif Type == "DarkText" and (Instance:IsA("TextLabel") or Instance:IsA("TextButton") or Instance:IsA("TextBox")) then
        Instance.TextColor3 = theme["Color Dark Text"]
        DEDSEC.updateTextStyleAndGlow(Instance)
        DEDSEC.hookTextChange(Instance)
    elseif Type == "ScrollBar" and Instance:IsA("ScrollingFrame") then
        Instance.ScrollBarImageColor3 = theme["Color Theme"]
    end
end


   
    function DEDSEC .UpdateAllTextAndIconsColors()
   


local function updateRecursive(instance)
        for _, child in pairs(instance:GetChildren()) do
            local isAvatar = child.Name == "AvatarImage"
            local isDiscordLogo = child.Name == "DiscordLogo"
            local isOwnerImage = child.Name == "OwnerImage"
            local isVictimAvatar = child.Name == "VictimAvatar"
            local isWindowBackground = child.Name == "WindowBackground"
            local isExternalCorner = child.Name == "ExternalCornerImage"
            local isPlayerImage = child.Name == "PlayerImage"
            local isCloseButton = child.Name == "CloseButton"
            if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
                child.TextColor3 = currentTextColorObject
                DEDSEC.updateTextStyleAndGlow(child)
                DEDSEC.hookTextChange(child)
            elseif child:IsA("ImageLabel") and not isAvatar and not isDiscordLogo and not isOwnerImage and not isVictimAvatar and not isPlayerImage then
                if isWindowBackground and DEDSEC.Save.LockBackgroundImageColor then
                    -- لا تغير لون صورة الخلفية إذا كان القفل مفعلاً
                elseif isExternalCorner then
                    if externalImageColorMode == "تلقائي" then
                        child.ImageColor3 = currentTextColorObject
                    elseif externalImageColorMode == "مخصص" and DEDSEC.Save.CustomExternalImageColor then
                        local c = DEDSEC.Save.CustomExternalImageColor
                        child.ImageColor3 = Color3.fromRGB(c.R or 255, c.G or 255, c.B or 255)
                    else
                        local colorMap = ArabicColorMap
                        child.ImageColor3 = colorMap[externalImageColorMode] or currentTextColorObject
                    end
                else
                    child.ImageColor3 = currentTextColorObject
