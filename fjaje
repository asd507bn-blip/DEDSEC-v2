    function DEDSEC :GetIcon(index)
    if type(index) ~= "string" or index:find("rbxassetid://") or #index == 0 then
        return index
    end
    local firstMatch = nil
    index = string.lower(index):gsub("lucide", ""):gsub("-", "")
    if self.Icons[index] then
        return self.Icons[index]
    end
    for Name, Icon in self.Icons do
        if Name == index then
            return Icon
        elseif not firstMatch and Name:find(index, 1, true) then
            firstMatch = Icon
        end
    end
    return firstMatch or index
end

 
    function DEDSEC :SetTextSize(NewSize)
    if type(NewSize) ~= "number" then return end
    NewSize = math.clamp(NewSize, 8, 20)
    DEDSEC.Save.TextSize = NewSize
    DEDSEC.DebouncedSettingsSave()
    currentTextSize = NewSize
    local excludedNames = {
        Title = true,
        WelcomeText = true,
        WelcomeUser = true,
        CountLabel = true,
        OwnerText = true,
        OwnerSubtext = true,
        OwnerHandle = true,
        SectionLabel = true,
        ClockLabel = true,
        TimerLabel = true,
        VictimName = true,
        VictimInfoText = true,
    }
    for _, entry in ipairs(DEDSEC.Instances) do
        if entry.Type == "Text" or entry.Type == "DarkText" then
            local instance = entry.Instance
            if (instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox")) then
                if not excludedNames[instance.Name] then
                    -- احترام UITextSizeConstraint إذا موجود
                    local constraint = instance:FindFirstChildOfClass("UITextSizeConstraint")
                    if constraint then
                        -- اضبط الحجم ضمن حدوده
                        instance.TextSize = math.clamp(NewSize, constraint.MinTextSize, constraint.MaxTextSize)
                    else
                        instance.TextSize = NewSize
                    end
                end
            end
        end
    end
-- تحديث عناوين الأقسام بحجم أساسي مخصص (14) يتحرك نسبياً مع حجم النصوص العام
    local SECTION_BASE_SIZE = 16
    local sectionOffset = NewSize - 12 -- 10 هو الحجم الافتراضي العام
    local sectionDesiredSize = SECTION_BASE_SIZE + sectionOffset
    for _, entry in ipairs(DEDSEC.Instances) do
        if entry.Type == "Text" then
            local instance = entry.Instance
            if instance and instance.Name == "SectionLabel" and (instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox")) then
                local constraint = instance:FindFirstChildOfClass("UITextSizeConstraint")
                if constraint then
                    instance.TextSize = math.clamp(sectionDesiredSize, constraint.MinTextSize, constraint.MaxTextSize)
                else
                    instance.TextSize = sectionDesiredSize
                end
            end
        end
    end
    -- تحديث عناصر الضحية بحجم مخصص
if UIRefs then
        if Window and Window.UpdateVictimTextLimits then
            Window:UpdateVictimTextLimits(true)
        end
    end
