function createVictimSelectTool()
    local tool = Instance.new("Tool")
    tool.Name = "اداه تحديد ضحيه"
    tool.RequiresHandle = false
    tool.CanBeDropped = false
    tool.TextureId = "rbxassetid://90331231314221"
    tool.Activated:Connect(function()
        local mouse = Player:GetMouse()
        local target = mouse.Target
        if target then
            local character = target:FindFirstAncestorOfClass("Model")
            if character and character:FindFirstChildOfClass("Humanoid") then
                for _, otherPlayer in pairs(Players:GetPlayers()) do
                    if otherPlayer.Character == character then
                        if otherPlayer.Name == Player.Name then
                            showNotification("🔴 لا يمكنك تحديد نفسك كضحية", nil, false)
                            return
                        end
                        local isProtected = false
                        local isOwner = false
                        for _, protectedName in ipairs(protectedUsernames) do
                            if otherPlayer.Name:lower() == protectedName:lower() then isProtected = true; break end
                        end
                        for _, ownerName in ipairs(ownerAccounts) do
                            if otherPlayer.Name:lower() == ownerName:lower() then isOwner = true; break end
                        end
                        if isProtected then
                            if isOwner then
                                showNotification("هذا المستخدم هو مالك نظام DEDSEC وصاحبه ولا يمكنك تحديده", nil, false, "DEDSEC Message", "rbxassetid://128695199824314")
                            else
                                showNotification("هذا المستخدم محمي من صاحب سكربت", nil, false, "DEDSEC Message", "rbxassetid://128695199824314")
                            end
                            return
                        end
                        updateVictimInfo(otherPlayer)
                        return
                    end
                end
            end
        end
    end)
    return tool
end
