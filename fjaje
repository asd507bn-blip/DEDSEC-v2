local function applyFontToAll(container)
            for _, obj in ipairs(container:GetDescendants()) do
                if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                    if not originalFonts[obj] then originalFonts[obj] = obj.Font end
                    obj.Font = currentFontEnum
                end
            end
        end
        if ScreenGui and ScreenGui.Parent then applyFontToAll(ScreenGui) end
        if NotificationGui and NotificationGui.Parent then applyFontToAll(NotificationGui) end
        if window and window.ContainerList then
            for _, container in ipairs(window.ContainerList) do
                local wasNil = (container.Parent == nil)
                if wasNil then container.Parent = ScreenGui end
                applyFontToAll(container)
                if wasNil then container.Parent = nil end
            end
        end
        -- تطبيق على الإشعارات الجديدة تلقائياً عند إنشائها
        NotificationGui.DescendantAdded:Connect(function(obj)
            if currentFontEnum and (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) then
                task.defer(function()
                    if obj.Parent then
                        obj.Font = currentFontEnum
                    end
                end)
