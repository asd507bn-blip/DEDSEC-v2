local function TimeFormatClock()
                local now = os.date("*t")
                local hour, minute = now.hour, now.min
                local period = hour >= 12 and "PM" or "AM"
                hour = hour % 12
                if hour == 0 then hour = 12 end
                return string.format("%d:%02d %s", hour, minute, period)
            end
            
local function TimeFormatServer(seconds)
                local days = math.floor(seconds / 86400)
                seconds = seconds % 86400
                local hours = math.floor(seconds / 3600)
                seconds = seconds % 3600
                local minutes = math.floor(seconds / 60)
                local secs = math.floor(seconds % 60)
                return string.format("ServerTime %dd %02dh %02dm %02ds", days, hours, minutes, secs)
