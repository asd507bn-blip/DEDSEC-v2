    -- مضاد NV (لا يحتاج أدمن) - نسخة محسّنة لتجنب التهنيج
    local function isNVVisualObject(obj)
        return obj:IsA("Highlight")
            or obj:IsA("BillboardGui")
            or obj:IsA("BoxHandleAdornment")
            or obj:IsA("SphereHandleAdornment")
            or obj:IsA("SurfaceGui")
            or obj:IsA("SelectionBox")
    end

    local function removeESP(container)
        for _, obj in ipairs(container:GetDescendants()) do
            if isNVVisualObject(obj) then
                obj:Destroy()
            end
        end
    end

    local function watchESP(container)
        local conn = container.DescendantAdded:Connect(function(obj)
            if not isNVVisualObject(obj) then return end
            task.defer(function()
                if activeFeatures.antiNV and obj.Parent and isNVVisualObject(obj) then
                    obj:Destroy()
                end
            end)
        end)
        table.insert(antiNVConnections, conn)
    end

    local function protectCharNV(char)
        if not activeFeatures.antiNV or not char then return end
        removeESP(char)
        watchESP(char)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            antiNVHumanoids[hum] = hum.DisplayDistanceType
            hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        end
    end

    local function startAntiNV()
        -- تنظيف واحد عند التفعيل فقط، ثم مراقبة العناصر الجديدة عبر الأحداث.
        removeESP(Workspace)
        removeESP(CoreGui)
        watchESP(Workspace)
        watchESP(CoreGui)
        if Player.Character then
            protectCharNV(Player.Character)
        end
        local charConn = Player.CharacterAdded:Connect(function(char)
            task.defer(function()
                if activeFeatures.antiNV and char == Player.Character then
                    protectCharNV(char)
                end
            end)
        end)
        table.insert(antiNVConnections, charConn)
    end

    local function stopAntiNV()
        for _, conn in ipairs(antiNVConnections) do
            pcall(function() conn:Disconnect() end)
        end
        antiNVConnections = {}
        for hum, originalDisplayDistance in pairs(antiNVHumanoids) do
            pcall(function()
                if hum.Parent then
                    hum.DisplayDistanceType = originalDisplayDistance
                end
            end)
        end
        antiNVHumanoids = {}
    end

