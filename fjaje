            if UIRefs.minimizeButtonGlowData.gradient then
                UIRefs.minimizeButtonGlowData.gradient.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
                    ColorSequenceKeypoint.new(0.5, newColor),
