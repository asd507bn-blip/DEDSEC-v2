local function updateGlowColor(newColor)
        currentGlowColor = newColor

        UIRefs = UIRefs or {}
        UIRefs.glowStrokes = UIRefs.glowStrokes or {}

        for btn, data in pairs(UIRefs.glowStrokes) do
            if data.stroke and data.stroke.Parent then
                data.stroke.Color = newColor
                if data.gradient then
                    data.gradient.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
                        ColorSequenceKeypoint.new(0.5, newColor),
                        ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))
                    })
                end
            end
        end
        if ScreenGui then
            for _, obj in ipairs(ScreenGui:GetDescendants()) do
                if obj:IsA("UIStroke") and obj.Name ~= "MinimizeButtonGlow" and obj.Name ~= "DialogGlow" and obj.Name ~= "DiscordInviteGlow" and obj.Name ~= "QuickSwatchBorder" then
                    local parent = obj.Parent
                    if parent and (parent:IsA("TextButton") or parent:IsA("Frame") or parent:IsA("ScrollingFrame")) then
                        obj.Color = newColor
                        local grad = obj:FindFirstChildOfClass("UIGradient")
                        if grad then
                            grad.Color = ColorSequence.new({
                                ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
                                ColorSequenceKeypoint.new(0.5, newColor),
                                ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))
                            })
                        end
                    end
                end
            end
        end
        Window._updateGlowColor = function(newColor)
            updateGlowColor(newColor)
        end
        if BorderStroke then
            BorderStroke.Color = newColor
            if StrokeGradient then
                StrokeGradient.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
                    ColorSequenceKeypoint.new(0.5, newColor),
                    ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))
