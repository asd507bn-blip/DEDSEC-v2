local SetProps, SetChildren, InsertTheme, Create do
    InsertTheme = function(Instance, Type)
        table.insert(DEDSEC.Instances, {
            Instance = Instance,
            Type = Type
        })
        DEDSEC.ApplyCurrentThemeToElement(Instance, Type)
        return Instance
    end

    SetChildren = function(Instance, Children)
        if Children then
            table.foreach(Children, function(_,Child)
                Child.Parent = Instance
            end)
        end
        return Instance
    end

    SetProps = function(Instance, Props)
        if Props then
            for prop, value in pairs(Props) do
                Instance[prop] = value
            end
        end
        return Instance
    end

    Create = function(...)
        local args = {...}
        if type(args) ~= "table" then return end
        local new = Instance.new(args[1])
        local Children = {}

        if type(args[2]) == "table" then
            SetProps(new, args[2])
            SetChildren(new, args[3])
            Children = args[3] or {}
        elseif typeof(args[2]) == "Instance" then
            new.Parent = args[2]
            SetProps(new, args[3])
            SetChildren(new, args[4])
            Children = args[4] or {}
        end

        if (new:IsA("TextLabel") or new:IsA("TextButton") or new:IsA("TextBox")) and not new:GetAttribute("NoAutoTheme") then
            InsertTheme(new, "Text")
        elseif new:IsA("ImageLabel") and new.Name ~= "AvatarImage" and new.Name ~= "DiscordLogo" and new.Name ~= "OwnerImage" and new.Name ~= "VictimAvatar" and new.Name ~= "ExternalCornerImage" and not new:GetAttribute("NoAutoTheme") then
            InsertTheme(new, "Text")
        elseif new:IsA("ImageButton") and (new.Name == "Close" or new.Name == "Minimize" or new.Name == "MinimizeButton") and not new:GetAttribute("NoAutoTheme") then
            InsertTheme(new, "Text")
        end

        return new
    end

    


